# AppArmor profile for worksuite-ai, the AI assistant's control service (services/ai; WSOS-SEC-009). Applied by the unit
# (AppArmorProfile=), not by path: it runs on worksuite-node, which other services share.
#
# worksuite-ai: the control service. Network for model downloads (https, catalog hosts only, enforced in
# src/fetch.ts); its own data under ~/.local/share/worksuite/ai; reads the catalog, the policy and admin models.
# llama.cpp runs under its own profile, worksuite-ai-engine, with no network.
abi <abi/4.0>,
include <tunables/global>

profile worksuite-ai flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>
  include <abstractions/openssl>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  unix (create, connect, send, receive, bind, listen, accept) type=stream,

  /{usr/,}bin/{sh,dash} ix,
  /usr/bin/worksuite-node rix,
  /usr/lib/worksuite/shell/electron/electron mrix,
  /usr/lib/worksuite/shell/electron/** mr,
  /usr/lib/worksuite/ai/** r,
  /usr/lib/@{multiarch}/** mr,
  /usr/share/worksuite/ai/** r,
  /etc/worksuite/ r,
  /etc/worksuite/ai-policy.json r,
  /etc/worksuite/ai-catalog.json r,
  /var/lib/worksuite/ai/** r,
  /dev/dri/ r,
  /usr/share/vulkan/icd.d/ r,
  /etc/vulkan/icd.d/ r,
  @{PROC}/** r,
  /sys/devices/system/cpu/** r,
  /dev/shm/** rwk,
  /tmp/** rwk,

  owner @{HOME}/.local/share/worksuite/ rw,
  owner @{HOME}/.local/share/worksuite/ai/ rw,
  owner @{HOME}/.local/share/worksuite/ai/** rwk,
  owner /run/user/*/worksuite/ rw,
  owner /run/user/*/worksuite/ai.sock rw,
  owner /run/user/*/worksuite/ai-engine/engine.sock rw,

  # Starts and stops the engine unit through the user manager.
  /usr/bin/systemctl rix,
  owner /run/user/*/systemd/private rw,
  dbus (send, receive) bus=session,
}
