# AppArmor profile for worksuite-package-service (WSOS-SEC-009). Applied by the unit (AppArmorProfile=).
# The service itself is confined; apt-get, dpkg and flatpak run maintainer scripts and so leave confinement (Ux) —
# the service only ever starts them with fixed argument vectors (WSOS-SEC-007).
abi <abi/4.0>,
include <tunables/global>

profile worksuite-package-service flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>
  include <abstractions/openssl>

  capability dac_override dac_read_search fowner chown setuid setgid kill,
  network inet stream,
  network inet6 stream,
  network unix stream,
  dbus (send, receive, bind) bus=system,
  unix (create, connect, send, receive) type=stream,

  /{usr/,}bin/{sh,dash} ix,
  /usr/bin/worksuite-node rix,
  /usr/lib/worksuite/shell/electron/electron mrix,
  /usr/lib/worksuite/shell/electron/** mr,
  /usr/lib/worksuite/package-service/** r,
  /usr/share/worksuite/** r,
  /usr/share/dbus-1/interfaces/** r,
  /etc/** r,
  @{PROC}/** r,
  /sys/class/power_supply/ r,
  /sys/devices/** r,
  /sys/class/power_supply/** r,
  /dev/shm/** rwk,
  /tmp/** rwk,

  owner /var/lib/worksuite-package-service/ rw,
  owner /var/lib/worksuite-package-service/** rwk,
  /var/log/worksuite/ rw,
  /var/log/worksuite/** rwk,
  /run/worksuite-device-agent/policy.json r,
  /run/reboot-required r,
  /var/lib/dpkg/** r,
  /var/lib/apt/** r,

  # Drivers (Settings › Drivers): devices, modaliases, kernel modules and firmware files, Secure Boot state.
  /sys/bus/ r,
  /sys/bus/** r,
  /sys/module/ r,
  /sys/firmware/efi/efivars/SecureBoot-* r,
  /{usr/,}lib/modules/** r,
  /{usr/,}lib/firmware/** r,
  /var/lib/dkms/mok.pub r,

  /usr/bin/test rix,
  /usr/bin/journalctl Px -> worksuite-package-service//journal,
  /usr/bin/{busctl,systemctl} Ux,
  # Driver installs and checks: modprobe (reload after firmware), isenkram-lookup (python, reads AppStream), fwupd's
  # client, mokutil (Secure Boot key enrolment), update-initramfs (GPU fallback). Fixed argument vectors only.
  /usr/{s,}bin/{modprobe,kmod,mokutil,update-initramfs} Ux,
  /usr/bin/{isenkram-lookup,fwupdmgr} Ux,
  /usr/bin/{apt-get,apt-cache,dpkg,dpkg-query,flatpak} Ux,

  profile journal {
    include <abstractions/base>
    /usr/bin/journalctl mr,
    /var/log/journal/ r,
    /var/log/journal/** r,
    /run/log/journal/ r,
    /run/log/journal/** r,
    /etc/machine-id r,
    /proc/** r,
    /sys/** r,
  }

  deny /home/** rwx,
  deny /root/** rwx,
}
