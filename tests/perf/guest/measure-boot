#!/bin/sh
# Guest side, boot and idle metrics (WSOS-PRF-001/003/004). Prints "WORKSUITE_PERF <metric> <value>" lines.
#   boot_to_greeter_s   kernel start → greetd active (+ firmware/loader when systemd-analyze knows them)
#   userspace_s         systemd-analyze userspace time
#   idle_mem_mib        MemTotal - MemAvailable after IDLE_SETTLE seconds of idle
#   idle_cpu_pct        whole-system busy % over IDLE_WINDOW seconds
set -u
IDLE_SETTLE=${IDLE_SETTLE:-60}
IDLE_WINDOW=${IDLE_WINDOW:-30}
out() { printf 'WORKSUITE_PERF %s %s\n' "$1" "$2"; }

# Wait until boot is finished so systemd-analyze answers.
i=0; while ! systemd-analyze time >/dev/null 2>&1 && [ $i -lt 300 ]; do sleep 1; i=$((i + 1)); done
t=$(systemd-analyze time 2>/dev/null | head -n1)
printf 'WORKSUITE_PERF_RAW %s\n' "$t"
# "Startup finished in 2.1s (firmware) + 1.0s (loader) + 3.2s (kernel) + 9.8s (userspace) = 16.1s"
secs() { # "1min 2.345s" / "850ms" / "3.2s" → seconds
  echo "$1" | awk '{ s = 0; for (i = 1; i <= NF; i++) { v = $i; if (v ~ /min$/) { sub(/min$/, "", v); s += v * 60 } else if (v ~ /ms$/) { sub(/ms$/, "", v); s += v / 1000 } else if (v ~ /s$/) { sub(/s$/, "", v); s += v } } printf "%.2f", s }'
}
part() { echo "$t" | sed 's/^Startup finished in //; s/ = .*//' | tr '+' '\n' | sed -n "s/^ *\(.*\) ($1) *\$/\1/p"; }
pre=0
for p in firmware loader; do v=$(part $p); [ -n "$v" ] && pre=$(awk -v a="$pre" -v b="$(secs "$v")" 'BEGIN { printf "%.2f", a + b }'); done
us=$(part userspace); [ -n "$us" ] && out userspace_s "$(secs "$us")"
g=$(systemctl show -p ActiveEnterTimestampMonotonic --value greetd.service 2>/dev/null || echo 0)
if [ "${g:-0}" -gt 0 ] 2>/dev/null; then
  out boot_to_greeter_s "$(awk -v a="$pre" -v m="$g" 'BEGIN { printf "%.2f", a + m / 1000000 }')"
fi

sleep "$IDLE_SETTLE"
cpu() { awk '/^cpu / { idle = $5 + $6; tot = 0; for (i = 2; i <= NF; i++) tot += $i; print tot, idle }' /proc/stat; }
set -- $(cpu); t0=$1; i0=$2
sleep "$IDLE_WINDOW"
set -- $(cpu); t1=$1; i1=$2
out idle_cpu_pct "$(awk -v dt=$((t1 - t0)) -v di=$((i1 - i0)) 'BEGIN { printf "%.2f", (dt > 0 ? 100 * (dt - di) / dt : 0) }')"
out idle_mem_mib "$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%d", (t - a) / 1024 }' /proc/meminfo)"
