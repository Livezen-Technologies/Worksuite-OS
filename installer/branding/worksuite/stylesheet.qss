/* WorkSuite installer pages (design: "WorkSuite OS Boot & Install" › Installer). Sidebar and footer are QML. */
* {
    font-family: "IBM Plex Sans";
    font-size: 14px;
}
#mainApp, QWidget {
    background-color: #0A1A3D;
    color: #E8EEFA;
}
QLabel { background: transparent; color: #E8EEFA; }
QLabel:disabled { color: #5E739C; }
/* Page titles some modules set (welcome, summary, finished) */
/* Calamares sets these as rich-text <h1> (twice the base size): 16px base gives the design's 32px titles. */
QLabel#mainText, QLabel#titleLabel { font-size: 16px; }

QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: rgba(4, 10, 26, 0.5);
    border: 1px solid rgba(127, 178, 255, 0.2);
    border-radius: 10px;
    padding: 0 14px;
    min-height: 42px;
    color: #E8EEFA;
    selection-background-color: #1F6BFF;
}
QPlainTextEdit, QTextEdit { padding: 10px 14px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #7FB2FF; }
QLineEdit[echoMode="2"] { lineedit-password-character: 9679; }
QComboBox::drop-down { border: none; width: 36px; }
QComboBox::down-arrow { image: url(/usr/share/calamares/branding/worksuite/chevron.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #0E2048; border: 1px solid rgba(127, 178, 255, 0.2); selection-background-color: #1F6BFF; outline: 0;
}

QListView, QTreeView, QTableView {
    background-color: rgba(14, 32, 72, 0.6);
    border: 1px solid rgba(127, 178, 255, 0.16);
    border-radius: 12px;
    padding: 6px;
    outline: 0;
    alternate-background-color: rgba(14, 32, 72, 0.6);
}
QListView::item, QTreeView::item { padding: 9px 10px; border-radius: 8px; color: #E8EEFA; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #1F6BFF; color: #FFFFFF; }
QListView::item:hover:!selected, QTreeView::item:hover:!selected { background: rgba(127, 178, 255, 0.08); }
QHeaderView::section { background: transparent; color: #8FA3C8; border: none; padding: 6px 10px; font-size: 12px; }

QPushButton, QToolButton {
    background: transparent;
    color: #E8EEFA;
    border: 1px solid rgba(127, 178, 255, 0.25);
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 500;
}
QPushButton:hover, QToolButton:hover { background: rgba(255, 255, 255, 0.06); }
QPushButton:pressed, QToolButton:pressed { background: rgba(255, 255, 255, 0.1); }
QPushButton:default { background: #1F6BFF; border: none; color: #FFFFFF; font-weight: 600; }
QPushButton:disabled, QToolButton:disabled { color: #5E739C; border-color: rgba(127, 178, 255, 0.1); }

QRadioButton, QCheckBox { spacing: 10px; color: #E8EEFA; background: transparent; }
QRadioButton::indicator, QCheckBox::indicator { width: 18px; height: 18px; }
QRadioButton::indicator { border-radius: 9px; border: 2px solid #5E739C; background: transparent; }
QRadioButton::indicator:checked { border: 5px solid #1F6BFF; background: #FFFFFF; }
QCheckBox::indicator { border-radius: 4px; border: 2px solid #5E739C; background: transparent; }
/* Stylesheet urls resolve against Calamares' working directory, not this file: name the installed branding path. */
QCheckBox::indicator:checked { border: 2px solid #1F6BFF; background: #1F6BFF; image: url(/usr/share/calamares/branding/worksuite/check.svg); }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #7FB2FF; }
QCheckBox::indicator:checked:hover { border-color: #3A7DFF; background: #3A7DFF; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: rgba(127, 178, 255, 0.2); }
QCheckBox:focus, QRadioButton:focus { outline: none; }

QGroupBox {
    border: 1px solid rgba(127, 178, 255, 0.16);
    border-radius: 12px;
    margin-top: 22px;
    padding: 16px;
    background: rgba(14, 32, 72, 0.6);
}
QGroupBox::title { subcontrol-origin: margin; left: 4px; padding: 0 4px; color: #C9D6EE; font-weight: 500; }

/* Install progress (design: Install progress): thin gradient bar */
QProgressBar {
    border: none;
    border-radius: 5px;
    background: rgba(127, 178, 255, 0.12);
    max-height: 10px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1F6BFF, stop:1 #18D4F0);
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: rgba(127, 178, 255, 0.25); border-radius: 4px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; height: 0; }
QScrollArea { border: none; background: transparent; }
QToolTip { background: #0E2048; color: #E8EEFA; border: 1px solid rgba(127, 178, 255, 0.25); padding: 6px 8px; }


/* Calamares fixes the QML sidebar's width (12 lines of text, at most 190 px) and the QML footer's height (at most
   64 px; CalamaresWindow.cpp). A minimum above a fixed size wins, so only minimums are set: Qt styles each panel
   as it is created, before those sizes are fixed, and a maximum set then would stick to the wrong panel.
   Checked by running Calamares offscreen: sidebar 260 px wide, footer 80 px high. */
#mainApp > QQuickWidget[maximumHeight="16777215"] { min-width: 260px; }
#mainApp > QQuickWidget { min-height: 80px; }

/* Partition page (design: Installer sub-steps › 2 · Disk, 2 · Encryption). worksuiteconfirm (WsStyle.cpp) lays the
   page out over the stock ChoicePage and names its parts; the device and swap lists and the passphrase fields are
   the stock ones, so the partitioning behaviour is Calamares' own. */
#ChoicePage { background: qradialgradient(cx:0.7, cy:0, radius:0.8, fx:0.7, fy:0, stop:0 #12306B, stop:0.75 #0A1A3D); }
#wsDiskPage, #wsDiskPage QWidget { background: transparent; }
#wsDiskPage QComboBox { min-height: 42px; padding: 0 12px; border: 1px solid rgba(127, 178, 255, 0.25); }
#wsDiskPage QLineEdit { min-height: 42px; border: 1px solid rgba(127, 178, 255, 0.25); }
#wsDiskPage QLineEdit:focus, #wsDiskPage QComboBox:focus { border-color: #7FB2FF; }
#wsDiskPage QLineEdit[wsState="bad"] { border-color: #FF8A7A; }
#wsDiskPage QLineEdit[wsState="good"] { border-color: #5FD39A; }
#wsDiskPage #wsDevCard { background: rgba(14, 32, 72, 0.6); border: 1px solid rgba(127, 178, 255, 0.16); border-radius: 12px; }
#wsDiskPage #wsDeviceCombo { min-height: 0; padding: 0; border: none; background: transparent; color: #E8EEFA; font-size: 15px; font-weight: 500; }
#wsDiskPage #wsDeviceCombo:disabled { color: #E8EEFA; }
#wsDiskPage #wsDeviceCombo[wsChoice="false"]::drop-down { width: 0; border: none; }
#wsDiskPage #wsDeviceCombo[wsChoice="false"]::down-arrow { image: none; width: 0; }
#wsDevNode { color: #8FA3C8; font-family: "IBM Plex Mono"; font-size: 12px; }
#wsEraseCard { background: rgba(255, 159, 90, 0.08); border: 1px solid #FF9F5A; border-radius: 12px; }
#wsCardTitle { font-size: 15px; font-weight: 600; }
#wsCardText { color: #C9D6EE; font-size: 13px; }
#wsCardHint { color: #8FA3C8; font-size: 13px; }
#wsDiskPage #wsPreview, #wsDiskPage #wsPassCard { background: rgba(14, 32, 72, 0.6); border: 1px solid rgba(127, 178, 255, 0.14); border-radius: 14px; }
#wsBeforeLabel { color: #8FA3C8; font-size: 13px; }
#wsAfterLabel { font-size: 13px; font-weight: 600; }
#wsCaption { color: #8FA3C8; font-size: 12px; }
#wsLegend { color: #C9D6EE; font-size: 12px; }
#wsDiskPage #wsChoiceCard { text-align: left; padding: 0; background: rgba(14, 32, 72, 0.6); border: 1px solid rgba(127, 178, 255, 0.16); border-radius: 12px; }
#wsDiskPage #wsChoiceCard:checked { background: rgba(31, 107, 255, 0.12); border-color: #1F6BFF; }
#wsDiskPage #wsChoiceCard:focus { border-color: #7FB2FF; }
#wsPassMsg { color: #8FA3C8; font-size: 13px; }
#wsPassMsg[wsState="bad"] { color: #FF8A7A; }
#wsPassMsg[wsState="good"] { color: #5FD39A; }
#wsPassStrength { color: #8FA3C8; font-size: 13px; }
#wsDiskPage #wsWarnBox { background: rgba(255, 159, 90, 0.08); border: 1px solid rgba(255, 159, 90, 0.3); border-radius: 12px; }
#wsWarnText { color: #C9D6EE; font-size: 13px; }

/* Install step: the bar and status line Calamares puts under the slideshow, lined up with the page content. */
#exec-progress { margin: 0 56px; }
#exec-message { color: #8FA3C8; font-family: "IBM Plex Mono"; font-size: 12px; margin: 6px 56px 18px; }

/* Message boxes and the error dialog (design: Dialog kit, Quit dialog). worksuiteconfirm (WsStyle.cpp) rebuilds them
   as a card on a frameless, translucent window: badge, title and text, then the buttons in a darker band.
   Every selector names QDialog: the plugin gives the application these rules too, for dialogs without a parent. */
QDialog[wsStyled="true"] { background: transparent; border: none; }
QDialog #wsDlgCard { background: #0F2350; border: 1px solid rgba(127, 178, 255, 0.2); border-radius: 18px; }
QDialog #wsDlgBody { background: transparent; border: none; }
QDialog #wsDlgButtons { background: rgba(4, 10, 26, 0.35); border: none; border-top: 1px solid rgba(127, 178, 255, 0.12); border-bottom-left-radius: 18px; border-bottom-right-radius: 18px; }
QDialog #wsDlgBadge { border-radius: 12px; background: rgba(31, 107, 255, 0.16); }
QDialog #wsDlgBadge[kind="error"] { background: rgba(255, 138, 122, 0.14); }
QDialog #wsDlgBadge[kind="warning"] { background: rgba(255, 159, 90, 0.14); }
QDialog #wsDlgBadge[large="true"] { border-radius: 14px; }
QDialog #wsDlgBadge[kind="info"] { background: rgba(95, 211, 154, 0.14); }
QDialog #wsDlgTitle { color: #E8EEFA; font-size: 17px; font-weight: 700; background: transparent; }
QDialog #wsDlgTitle[large="true"] { font-size: 19px; }
QDialog #wsDlgText { color: #C9D6EE; font-size: 14px; background: transparent; }
QDialog #wsDlgCode { font-family: "IBM Plex Mono"; font-size: 12px; color: #8FA3C8; background: rgba(4, 10, 26, 0.5); border: none; border-radius: 6px; padding: 6px 10px; }
QDialog QPushButton[wsRole] { min-width: 0; padding: 10px 18px; border-radius: 10px; font-size: 14px; }
QDialog[wsLarge="true"] QPushButton[wsRole] { padding: 11px 20px; }
QDialog QPushButton[wsRole="primary"] { background: #1F6BFF; color: #FFFFFF; border: none; font-weight: 600; }
QDialog QPushButton[wsRole="primary"]:hover { background: #3A7DFF; }
QDialog QPushButton[wsRole="caution"] { background: #D9452B; color: #FFFFFF; border: none; font-weight: 600; }
QDialog QPushButton[wsRole="caution"]:hover { background: #E5583F; }
QDialog QPushButton[wsRole="secondary"] { background: transparent; color: #E8EEFA; border: 1px solid rgba(127, 178, 255, 0.25); font-weight: 500; }
QDialog QPushButton[wsRole="danger"] { background: transparent; color: #FFB4A8; border: 1px solid rgba(255, 138, 122, 0.4); font-weight: 500; }
QDialog QPushButton[wsRole="danger"]:hover { background: rgba(255, 138, 122, 0.08); }
QDialog QPushButton[wsRole]:focus { border: 2px solid #7FB2FF; }
QDialog QPushButton[wsRole="primary"]:focus, QDialog QPushButton[wsRole="caution"]:focus { border: none; }
QDialogButtonBox { background: transparent; }

/* Confirm disk and Recovery key (design: Installer sub-steps › 5 · Confirm disk, 6 · Recovery key);
   worksuiteconfirm names its parts. */
#wsConfirm { background: qradialgradient(cx:0.7, cy:0, radius:0.8, fx:0.7, fy:0, stop:0 #3A1E22, stop:0.75 #0A1A3D); }
#wsRecovery { background: qradialgradient(cx:0.7, cy:0, radius:0.8, fx:0.7, fy:0, stop:0 #12306B, stop:0.75 #0A1A3D); }
#wsEyebrow { color: #18D4F0; font-family: "IBM Plex Mono"; font-size: 12px; letter-spacing: 1px; }
#wsConfirm #wsEyebrow { color: #FFB98A; }
#wsTitle { color: #E8EEFA; font-size: 30px; font-weight: 700; }
#wsSubtitle { color: #8FA3C8; font-size: 15px; }
#wsConfirm #wsSubtitle { color: #C9D6EE; }
#wsDiskCard { background: rgba(255, 159, 90, 0.06); border: 1px solid rgba(255, 159, 90, 0.4); border-radius: 14px; }
#wsDiskHeader { background: transparent; border: none; border-bottom: 1px solid rgba(255, 159, 90, 0.2); border-radius: 0; }
#wsDiskName { font-size: 16px; font-weight: 600; }
#wsDiskNode { color: #FFB98A; font-family: "IBM Plex Mono"; font-size: 13px; }
#wsTag { font-family: "IBM Plex Mono"; font-size: 11px; padding: 3px 0; border-radius: 5px; color: #7FB2FF; background: rgba(31, 107, 255, 0.18); }
#wsTag[kind="DELETE"] { color: #FF8A7A; background: rgba(255, 138, 122, 0.18); }
#wsTag[kind="FORMAT"] { color: #C9D6EE; background: rgba(127, 178, 255, 0.12); }
#wsOp { font-size: 14px; }
#wsPageBody, #wsDiskCard QWidget, #wsKeyBox QWidget { background: transparent; }
#wsFieldLabel { color: #C9D6EE; font-size: 13px; font-weight: 500; }
#wsConfirmInput { font-family: "IBM Plex Mono"; min-height: 42px; border-color: rgba(255, 159, 90, 0.5); }
#wsConfirmInput:focus { border-color: #FF9F5A; }
#wsKeyBox { background: rgba(4, 10, 26, 0.6); border: 1px dashed rgba(24, 212, 240, 0.5); border-radius: 16px; }
#wsKeyGroup { background: rgba(14, 32, 72, 0.8); border-radius: 8px; padding: 12px 0; font-family: "IBM Plex Mono"; font-size: 20px; letter-spacing: 2px; }
#wsKeyPlain { color: #5E739C; font-family: "IBM Plex Mono"; font-size: 12px; }
#wsAck { background: rgba(14, 32, 72, 0.6); border: 1px solid rgba(127, 178, 255, 0.2); border-radius: 12px; padding: 14px 16px; font-size: 15px; }
#wsAck:checked { border-color: #1F6BFF; }
/* Enroll this device (WSOS-INS-006): the Recovery key's navy, blue fields instead of the erase warning's orange. */
#wsEnroll { background: qradialgradient(cx:0.7, cy:0, radius:0.8, fx:0.7, fy:0, stop:0 #12306B, stop:0.75 #0A1A3D); }
#wsEnroll #wsConfirmInput { border-color: rgba(127, 178, 255, 0.35); }
#wsEnroll #wsConfirmInput:focus { border-color: #1F6BFF; }
#wsSecondary { min-height: 40px; padding: 0 18px; border-radius: 10px; border: 1px solid rgba(127, 178, 255, 0.3); background: transparent; color: #E8EEFA; }
#wsSecondary:hover { background: rgba(255, 255, 255, 0.06); }
#wsHint { color: #8FA3C8; font-size: 13px; }
/* Confirm disk: the background read, other systems found on the disk (dual boot) and what still blocks Install. */
#wsBusy { color: #18D4F0; font-size: 13px; }
#wsSystemsBox { background: rgba(255, 138, 122, 0.08); border: 1px solid rgba(255, 138, 122, 0.45); border-radius: 12px; }
#wsSystemsBox QWidget { background: transparent; }
#wsSystemsText { color: #FFD2C8; font-size: 14px; }
#wsValidation { color: #8FA3C8; font-size: 13px; }
#wsValidation[wsState="bad"] { color: #FF8A7A; }
#wsValidation[wsState="good"] { color: #5FD39A; }
#wsDiskPage #wsSystemsBox { background: rgba(255, 138, 122, 0.08); }
#wsDiskBusy { color: #18D4F0; font-size: 13px; }
/* Terms page: the agreement in a scrolling panel. */
#wsTermsText { background: #081634; color: #C9D6EE; border: 1px solid rgba(127, 178, 255, 0.16); border-radius: 12px; padding: 12px 14px; font-family: "IBM Plex Sans"; font-size: 13px; }

/* Calamares' error and confirmation dialogs (design: Message boxes): dark raised card, details on navy. */
QDialog { background: #0F2350; color: #E8EEFA; }
QDialog QLabel { color: #C9D6EE; }
QDialog QAbstractScrollArea, QDialog QAbstractScrollArea > QWidget { background: #081634; color: #C9D6EE; border: 1px solid rgba(127, 178, 255, 0.16); border-radius: 10px; }
QDialog #wsDlgCode > QWidget { background: transparent; border: none; }
