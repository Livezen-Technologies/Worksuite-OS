#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
  dpkg-divert --package worksuite-branding --remove --rename --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = abort-install ]; then
  dpkg-divert --package worksuite-branding --remove --rename --divert /etc/skel/.face.distrib /etc/skel/.face
fi
#DEBHELPER#
exit 0
