#!/usr/bin/make -f
# One source package, one binary package per serviced component (SRS §11.6, §12.2). Built for amd64 and arm64
# from the same tag (WSOS-ARM-001).
%:
	dh $@

# The package service's one runtime dependency (dbus-next) is vendored from its lockfile at build time.
override_dh_auto_build:
	cd services/package-service && npm ci --omit=dev --ignore-scripts --no-audit --no-fund
	dh_auto_build
