#!/usr/bin/make -f
# One source package, one binary package per serviced component (SRS §11.6, §12.2). Built for amd64 and arm64
# from the same tag (WSOS-ARM-001). Run from the repository root with packaging/debian copied to ./debian
# (packaging/build-debs.sh does this).
export DH_VERBOSE = 1
include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_build:
	# The package service's one runtime dependency (dbus-next) is vendored from its lockfile.
	cd services/package-service && npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund
	find services/package-service/node_modules \( -name .npmignore -o -name .travis.yml -o -name "*.orig" -o -name .gitignore \) -delete
	# Shell: renderer + Electron main, and the Electron runtime for this architecture.
	cd shell && npm ci --no-audit --no-fund && npm run build
	# Calamares view module (installer/modules/worksuiteconfirm).
	cmake -S installer/modules/worksuiteconfirm -B build-installer -DCMAKE_BUILD_TYPE=RelWithDebInfo -DWORKSUITE_TESTS=ON
	cmake --build build-installer
	# Branding PNGs from the SVG sources.
	branding/render.sh build-branding
	dh_auto_build

override_dh_auto_install:
	dh_auto_install
	# calamares-settings-worksuite: config, branding and the two WorkSuite modules next to the stock ones.
	d=debian/calamares-settings-worksuite; m=$$d/usr/lib/$(DEB_HOST_MULTIARCH)/calamares/modules; \
	install -D -m 0644 installer/settings.conf $$d/etc/calamares/settings.conf && \
	install -d $$d/etc/calamares/modules && install -m 0644 installer/modules/*.conf $$d/etc/calamares/modules/ && \
	install -d $$d/usr/share/calamares/branding/worksuite && cp -a installer/branding/worksuite/. $$d/usr/share/calamares/branding/worksuite/ && \
	install -D -m 0644 installer/modules/worksuiteconfirm/module.desc $$m/worksuiteconfirm/module.desc && \
	install -m 0644 build-installer/libcalamares_viewmodule_worksuiteconfirm.so $$m/worksuiteconfirm/ && \
	install -D -m 0644 installer/modules/worksuiterecovery/module.desc $$m/worksuiterecovery/module.desc && \
	install -m 0644 installer/modules/worksuiterecovery/main.py $$m/worksuiterecovery/main.py
	# worksuite-archive-keyring: public keys only (packaging/keyring/README.md).
	d=debian/worksuite-archive-keyring; \
	install -d $$d/usr/share/keyrings $$d/usr/share/worksuite/keys/device-commands $$d/usr/share/worksuite/keys/release $$d/usr/share/doc/worksuite-archive-keyring && \
	install -m 0644 packaging/keyring/README.md $$d/usr/share/doc/worksuite-archive-keyring/README.md && \
	if [ -f packaging/keyring/worksuite-archive-keyring.gpg ]; then install -m 0644 packaging/keyring/worksuite-archive-keyring.gpg $$d/usr/share/keyrings/; fi && \
	for k in device-commands release; do for f in packaging/keyring/ed25519/$$k/*.pem; do [ -f "$$f" ] && install -m 0644 "$$f" $$d/usr/share/worksuite/keys/$$k/ || true; done; done
	# worksuite-branding
	d=debian/worksuite-branding; p=$$d/usr/share/plymouth/themes/worksuite; g=$$d/usr/share/grub/themes/worksuite; \
	install -D -m 0644 -t $$p branding/plymouth/worksuite.plymouth branding/plymouth/worksuite.script build-branding/plymouth/*.png && \
	install -D -m 0644 -t $$g branding/grub/theme.txt build-branding/grub/*.png build-branding/grub/*.pf2 && \
	install -D -m 0644 branding/grub/worksuite.cfg $$d/etc/default/grub.d/worksuite.cfg && \
	install -D -m 0644 -t $$d/usr/share/fonts/truetype/ibm-plex branding/fonts/ibm-plex/*.ttf && \
	install -D -m 0644 branding/icons/worksuite.svg $$d/usr/share/icons/hicolor/scalable/apps/worksuite.svg && \
	for s in 16 24 32 48 64 128 256 512; do install -D -m 0644 build-branding/icons/worksuite-$$s.png $$d/usr/share/icons/hicolor/$${s}x$${s}/apps/worksuite.png; done && \
	install -D -m 0644 build-branding/wallpaper.png $$d/usr/share/backgrounds/worksuite/default.png && \
	install -D -m 0644 branding/wallpaper.svg $$d/usr/share/backgrounds/worksuite/default.svg

override_dh_auto_test:
	cd build-installer && QT_QPA_PLATFORM=offscreen ctest --output-on-failure
	python3 -m unittest discover -s installer/modules/worksuiterecovery/tests
	cd services/sync && npm test
	cd services/credentials && npm test
	cd services/device-agent && npm test
	cd shell && npx vitest run

# Electron ships prebuilt and stripped; its shared-library needs are listed in debian/control.
override_dh_strip:
	dh_strip --exclude=usr/lib/worksuite/shell/electron
override_dh_shlibdeps:
	dh_shlibdeps --exclude=usr/lib/worksuite/shell/electron
override_dh_dwz:
