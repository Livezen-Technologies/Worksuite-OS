Package: worksuite-desktop
Architecture: all
Depends: worksuite-shell, worksuite-panel, worksuite-wayland-bridge, worksuite-background, worksuite-session,
 worksuite-user-services, worksuite-package-service, worksuite-device-agent, worksuite-branding,
 labwc, greetd, gtkgreet | worksuite-greeter, gtklock, swayidle,
 xdg-desktop-portal, xdg-desktop-portal-wlr, xdg-desktop-portal-gtk, gnome-keyring,
 pipewire, pipewire-pulse, wireplumber, network-manager, bluez, udisks2, upower, cups, policykit-1 | polkitd,
 flatpak, fcitx5, apparmor, ${misc:Depends}
Recommends: worksuite-office, fwupd
Conflicts: openssh-server
Description: WorkSuite OS desktop (metapackage)
 Pulls in the WorkSuite session, shell, native components, system services
 and the Debian desktop stack they rely on. No SSH server (WSOS-SEC-010).

Package: worksuite-shell
Architecture: amd64 arm64
Depends: libgtk-3-0t64 | libgtk-3-0, libnss3, libasound2t64 | libasound2, ${misc:Depends}
Description: WorkSuite shell (Electron launcher, dashboard, Settings, App Center)

Package: worksuite-panel
Architecture: amd64 arm64
Depends: worksuite-wayland-bridge, ${shlibs:Depends}, ${misc:Depends}
Description: WorkSuite native layer-shell taskbar

Package: worksuite-wayland-bridge
Architecture: amd64 arm64
Depends: labwc, ${shlibs:Depends}, ${misc:Depends}
Description: WorkSuite Wayland bridge (restricted window operations over D-Bus)

Package: worksuite-background
Architecture: amd64 arm64
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: WorkSuite wallpaper layer-shell surface per output

Package: worksuite-session
Architecture: all
Depends: labwc, systemd, dbus-user-session, ${misc:Depends}
Description: WorkSuite Wayland session file, systemd user units and launcher

Package: worksuite-user-services
Architecture: amd64 arm64
Depends: nodejs (>= 22.18), gnome-keyring, libsecret-tools, xdg-utils, ${misc:Depends}
Description: WorkSuite user services (catalog, files, credentials broker, sync)

Package: worksuite-package-service
Architecture: amd64 arm64
Depends: apt, dpkg, flatpak, polkitd | policykit-1, dbus, ${misc:Depends}
Description: WorkSuite system package service (D-Bus + polkit)

Package: worksuite-device-agent
Architecture: amd64 arm64
Depends: nodejs (>= 22), cryptsetup, tpm2-tools, dbus, ${misc:Depends}
Description: WorkSuite device agent (enrollment, policy, signed remote commands)

Package: worksuite-office
