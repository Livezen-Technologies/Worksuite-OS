#!/bin/sh
set -e
# /usr/lib/os-release (and the /etc/os-release link to it) names WorkSuite OS, ID_LIKE=debian; Debian's copy from
# base-files is kept beside it as os-release.debian.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package worksuite-branding --add --rename --divert /usr/lib/os-release.debian /usr/lib/os-release
fi
# New accounts start with the WorkSuite face (blue-to-cyan circle), not desktop-base's Debian logo: the Start menu,
# the sign-in screen and Settings show ~/.face, copied from /etc/skel at account creation.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package worksuite-branding --add --rename --divert /etc/skel/.face.distrib /etc/skel/.face
fi
# Settings › Appearance lists only the WorkSuite wallpapers: desktop-base's Debian ones (Debian logo artwork) are moved
# out of gnome-background-properties. Diverted, not deleted: removing worksuite-branding puts them back.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  mkdir -p /usr/share/worksuite/debian-backgrounds
  for n in ceratopsian emerald futureprototype homeworld joy-inksplat joy lines moonlight softwaves spacefun; do
    dpkg-divert --package worksuite-branding --add --rename --divert /usr/share/worksuite/debian-backgrounds/debian-$n.xml \
      /usr/share/gnome-background-properties/debian-$n.xml
  done
fi
#DEBHELPER#
exit 0
