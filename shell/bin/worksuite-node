#!/bin/sh
# Node runtime for WorkSuite services: the Node built into the shipped Electron (22.x; node:sqlite and TypeScript
# type stripping), so the image does not depend on Debian's older nodejs.
# #55: Node trusts only its bundled CA list. Add the system store (update-ca-certificates), so WorkSuite servers
# behind an organization's private CA work; a unit or the caller can still set its own NODE_EXTRA_CA_CERTS.
if [ -z "${NODE_EXTRA_CA_CERTS:-}" ] && [ -r /etc/ssl/certs/ca-certificates.crt ]; then
    export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
fi
ELECTRON_RUN_AS_NODE=1 exec /usr/lib/worksuite/shell/electron/electron "$@"
