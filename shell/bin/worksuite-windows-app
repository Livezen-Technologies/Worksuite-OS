#!/bin/sh
# WSOS-LCH-003: default handler for Windows programs (.exe, .msi, ...). It never runs the file: it only explains
# that Windows programs are not supported, and points to App Center. The file name is shown as text only.
set -u
name=$(basename -- "${1:-}" | tr -d '<>&')
title="Windows programs can't run here"
text="${name:+$name is a Windows program. }WorkSuite OS runs Linux apps and WorkSuite apps, not Windows programs. Look for the app, or one like it, in App Center, or ask your IT team."
case "${LANG:-}" in
    si*) title="Windows වැඩසටහන් මෙහි ධාවනය කළ නොහැක"
         text="${name:+$name යනු Windows වැඩසටහනකි. }WorkSuite OS හි Linux යෙදුම් සහ WorkSuite යෙදුම් ධාවනය වේ, Windows වැඩසටහන් නොවේ. App Center හි මෙම යෙදුම හෝ ඊට සමාන එකක් සොයන්න, නැතහොත් ඔබගේ IT කණ්ඩායමෙන් විමසන්න." ;;
    ta*) title="Windows நிரல்களை இங்கே இயக்க முடியாது"
         text="${name:+$name ஒரு Windows நிரல். }WorkSuite OS இல் Linux பயன்பாடுகளும் WorkSuite பயன்பாடுகளும் இயங்கும், Windows நிரல்கள் அல்ல. App Center இல் இந்தப் பயன்பாட்டை அல்லது இதைப் போன்ற ஒன்றைத் தேடுங்கள், அல்லது உங்கள் IT குழுவைக் கேளுங்கள்." ;;
esac
if command -v zenity >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    exec zenity --info --title="$title" --text="$text" --no-markup
fi
printf '%s\n%s\n' "$title" "$text" >&2
exit 0
