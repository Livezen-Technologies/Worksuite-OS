# WorkSuite OS defaults: /usr/share/applications/worksuite-mimeapps.list (XDG_CURRENT_DESKTOP=WorkSuite)
# and /etc/xdg/mimeapps.list.
[Default Applications]
# Folders: GNOME Files (Nautilus), as on Ubuntu.
inode/directory=org.gnome.Nautilus.desktop;
application/x-gnome-saved-search=org.gnome.Nautilus.desktop;
# worksuite:// goes to WorkSuite Desktop (worksuite.desktop, package worksuite) when it is installed, else to
# the web app windows (worksuite-url-handler.desktop): XDG takes the first installed entry of the list.
x-scheme-handler/worksuite=worksuite.desktop;worksuite-url-handler.desktop;
# Web: Firefox ESR. Audio and video: Celluloid (mpv).
x-scheme-handler/http=firefox-esr.desktop;
x-scheme-handler/https=firefox-esr.desktop;
text/html=firefox-esr.desktop;
application/xhtml+xml=firefox-esr.desktop;
video/mp4=io.github.celluloid_player.Celluloid.desktop;
video/webm=io.github.celluloid_player.Celluloid.desktop;
video/x-matroska=io.github.celluloid_player.Celluloid.desktop;
video/quicktime=io.github.celluloid_player.Celluloid.desktop;
video/x-msvideo=io.github.celluloid_player.Celluloid.desktop;
video/mpeg=io.github.celluloid_player.Celluloid.desktop;
audio/mpeg=io.github.celluloid_player.Celluloid.desktop;
audio/ogg=io.github.celluloid_player.Celluloid.desktop;
audio/flac=io.github.celluloid_player.Celluloid.desktop;
audio/x-wav=io.github.celluloid_player.Celluloid.desktop;
audio/mp4=io.github.celluloid_player.Celluloid.desktop;
audio/aac=io.github.celluloid_player.Celluloid.desktop;
# PDFs: Papers (GNOME's document viewer). Images: Loupe. Plain text and source files: Text Editor.
application/pdf=org.gnome.Papers.desktop;
image/png=org.gnome.Loupe.desktop;
image/jpeg=org.gnome.Loupe.desktop;
image/gif=org.gnome.Loupe.desktop;
image/webp=org.gnome.Loupe.desktop;
image/bmp=org.gnome.Loupe.desktop;
image/tiff=org.gnome.Loupe.desktop;
image/svg+xml=org.gnome.Loupe.desktop;
image/heif=org.gnome.Loupe.desktop;
image/avif=org.gnome.Loupe.desktop;
text/plain=org.gnome.TextEditor.desktop;
text/markdown=org.gnome.TextEditor.desktop;
application/json=org.gnome.TextEditor.desktop;
application/xml=org.gnome.TextEditor.desktop;
text/x-log=org.gnome.TextEditor.desktop;
# Office documents: WorkSuite Office (bundled in the image; its entry is worksuite-office.desktop, or
# onlyoffice-desktopeditors.desktop in builds that keep the upstream id: XDG takes the first installed).
# Worksuite FrameFlow has no project file type and opens no files from the command line,
# so it claims nothing; video and audio stay with Celluloid.
application/vnd.openxmlformats-officedocument.wordprocessingml.document=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/msword=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.oasis.opendocument.text=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/rtf=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
text/rtf=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.ms-excel=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.oasis.opendocument.spreadsheet=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
text/csv=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.ms-powerpoint=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
application/vnd.oasis.opendocument.presentation=worksuite-office.desktop;onlyoffice-desktopeditors.desktop;
# Windows programs never run: they open an explanation (WSOS-LCH-003).
application/x-ms-dos-executable=worksuite-windows-app.desktop;
application/x-msdownload=worksuite-windows-app.desktop;
application/vnd.microsoft.portable-executable=worksuite-windows-app.desktop;
application/x-msi=worksuite-windows-app.desktop;
application/x-ms-installer=worksuite-windows-app.desktop;
application/x-ms-shortcut=worksuite-windows-app.desktop;
application/x-bat=worksuite-windows-app.desktop;
application/x-msdos-program=worksuite-windows-app.desktop;
# Archives (zip, 7z, rar, tar.*, gz, xz, bz2, zst): Archive Manager, as on Ubuntu; WorkSuite Files' read-only browser
# (worksuite-files.desktop) stays the fallback when Archive Manager is not installed.
application/zip=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-zip-compressed=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-7z-compressed=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/vnd.rar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-rar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-rar-compressed=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-compressed-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-xz-compressed-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-bzip2-compressed-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-bzip-compressed-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-zstd-compressed-tar=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/gzip=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-gzip=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-xz=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-bzip2=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/x-bzip=org.gnome.FileRoller.desktop;worksuite-files.desktop;
application/zstd=org.gnome.FileRoller.desktop;worksuite-files.desktop;
