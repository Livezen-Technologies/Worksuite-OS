[Unit]
Description=Report WorkSuite OS boot status on the serial console (VM boot tests)
After=graphical.target greetd.service
Wants=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/worksuite/boot-marker
# /dev/console is the last console= on the kernel command line: the serial port (ttyS0 / ttyAMA0).
StandardOutput=journal+console

[Install]
WantedBy=graphical.target
