#!/bin/sh
# Live ISO, boot menu › "Update WorkSuite OS" (worksuite.mode=update): greetd's initial_session inside cage, as root.
# The splash's last frame first (worksuite_greeter.veil), then the updater window (worksuite_greeter.updater), which
# drives /usr/libexec/worksuite/worksuite-offline-update. If the window closes, greetd falls back to its normal greeter.
export PYTHONPATH=/usr/lib/worksuite/greeter
if [ "${WORKSUITE_INSTALLER_CHECKED:-}" = 1 ] || python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_foreign("cairo"); import worksuite_greeter.veil' >/dev/null 2>&1; then
    exec python3 -m worksuite_greeter.veil --title "WorkSuite OS" -- python3 -m worksuite_greeter.updater
fi
exec python3 -m worksuite_greeter.updater
