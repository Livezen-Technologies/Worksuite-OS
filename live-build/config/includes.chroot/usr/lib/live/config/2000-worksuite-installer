#!/bin/sh
# live-config component: runs only when booted from the WorkSuite OS ISO. The live session is the installer, full
# screen in cage. The installed system never sees this: Calamares copies the read-only image, not this live overlay.
set -e
[ -e /var/lib/live/config/worksuite-installer ] && exit 0
command -v calamares >/dev/null 2>&1 || exit 0
cat > /etc/greetd/config.toml <<'CONF'
[terminal]
vt = 1
# Installer first; if it exits, the normal greeter comes back.
[initial_session]
# The splash's last frame (worksuite_greeter.veil) first, then Calamares in front of it: no black screen while it starts.
command = "systemd-cat -t worksuite-installer env QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland worksuite-cage -s -- /usr/lib/worksuite/worksuite-installer-start"
user = "root"
[default_session]
command = "systemd-cat -t worksuite-greeter worksuite-cage -s -- gtkgreet -c /usr/bin/worksuite-session"
user = "_greetd"
CONF
touch /var/lib/live/config/worksuite-installer
