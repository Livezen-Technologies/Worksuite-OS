# WorkSuite desktop (pulls labwc, greetd, portals, PipeWire, NetworkManager, ...)
worksuite-desktop
# On-device AI assistant (services/ai): the service and llama.cpp runtime only; models are downloaded later, never in
# the image. Vulkan for GPUs that have it (the build installs no recommends).
worksuite-ai
libvulkan1
mesa-vulkan-drivers
# Locales: locale-gen and /etc/locale.gen. Without it only C.utf8 exists, so LANG=en_US.UTF-8 made foot and Firefox
# warn "locale not supported", and Calamares' localecfg (which runs locale-gen only when /etc/locale.gen exists) could
# not generate the language chosen in the installer. The image's locales: hook 0100-worksuite-defaults.
locales
# Installer (live only; Calamares removes itself from the installed system)
calamares
calamares-settings-worksuite
# Tools Calamares' modules run (only recommended, and the build installs no recommends): unpackfs needs unsquashfs
# and rsync, bootloader needs efibootmgr, and the signed GRUB for Secure Boot behind shim.
squashfs-tools
rsync
efibootmgr
#if ARCHITECTURES amd64
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-signed
#endif
worksuite-branding
# Hardware / boot
grub-efi
shim-signed
cryptsetup
# File systems the installer creates: FAT32 for the EFI partition (kpmcore runs mkfs.fat)
dosfstools
mtools
cryptsetup-initramfs
# update-initramfs hooks: keyboard map for the passphrase prompt, and the zstd compressor (initramfs-tools default)
console-setup
zstd
tpm2-tools
plymouth
# Crashed apps: core dumps go to the journal, the shell says "X quit unexpectedly" (electron/sessionHost.ts).
systemd-coredump
# Scripts for the installer's language list and the desktop (Sinhala, Tamil, Devanagari, Arabic, ...)
fonts-noto-core
# Sinhala and Tamil Unicode text: Noto UI variants (tighter line height for the shell and installer), the LKLUG
# Sinhala font as a second face, and fontconfig preferences in /etc/fonts/conf.d/60-worksuite-sinhala-tamil.conf.
fonts-noto-ui-core
fonts-lklug-sinhala
fonts-noto-mono
fontconfig
# Emoji in the shell (emoji picker, clipboard history) and apps; without it they were empty boxes.
fonts-noto-color-emoji
# Recovery (§9.2)
dialog
udisks2
# Settings bridge CLIs (shell/electron/system.ts): nmcli, bluetoothctl, wpctl, upower, lpstat, wlr-randr, udisksctl
network-manager
# Wi-Fi (#31): NetworkManager drives every Wi-Fi card through wpa_supplicant, which network-manager only recommends
# (and the build installs no recommends): without it each Wi-Fi device stayed "unavailable" and no network was ever
# listed. rfkill unblocks radios switched off by a key or a previous session (the console user may, through
# logind's uaccess on /dev/rfkill); iw for diagnostics.
wpasupplicant
rfkill
iw
# WireGuard VPN (WSOS-INT-001): NetworkManager's built-in wireguard type (kernel module is in-tree); wg(8) for
# diagnostics; nft for the managed VPN kill switch (services/device-agent/src/vpn.ts)
wireguard-tools
nftables
# WorkSuite Security antivirus (services/device-agent/src/security.ts).
clamav
clamav-freshclam
# Real-time protection (#38): clamd + clamonacc (worksuite-onaccess.service) and clamdscan for Downloads scans; the
# daemon idles until the policy turns real-time protection on. dnsmasq-base: NetworkManager's dnsmasq for the DNS
# blocklist (services/device-agent/src/protection.ts).
clamav-daemon
clamdscan
dnsmasq-base
# OpenVPN profiles imported in Settings › Network › VPN (shell/electron/openvpn.ts)
network-manager-openvpn
bluez
wireplumber
upower
# Printing (Settings › Printers, shell/electron/printers.ts; issue #51). The build installs no recommends, so cups'
# own (avahi-daemon, cups-browsed, drivers) were missing: network printers were never discovered and .local names
# never resolved. cups-browsed adds shared queues automatically, ipp-usb makes IPP-over-USB printers driverless,
# cups-ipp-utils brings ippfind, and the printer-driver-* packages cover common printers without IPP Everywhere.
cups
cups-client
cups-daemon
cups-filters
cups-browsed
cups-ipp-utils
ipp-usb
avahi-daemon
libnss-mdns
printer-driver-gutenprint
printer-driver-hpcups
printer-driver-brlaser
printer-driver-splix
printer-driver-pxljr
printer-driver-c2esp
wlr-randr
# Touchscreen, pen and touch mode (shell/electron/touch.ts): device listing and tablet-mode switch events,
# auto-rotate (monitor-sensor), and the on-screen keyboard (virtual-keyboard + layer-shell under Labwc)
libinput-tools
iio-sensor-proxy
wvkbd
# WorkSuite greeter (WSOS-AUTH-001; the build installs no recommends)
python3-gi
python3-gi-cairo
gir1.2-gtk-4.0
# worksuite-osk (the WorkSuite on-screen keyboard) is a gtk4-layer-shell surface; without it the shell falls back to wvkbd.
gir1.2-gtk4layershell-1.0
# The library itself: Debian's typelib package does not depend on it, and worksuite-osk preloads it.
libgtk4-layer-shell0
# WorkSuite's own polkit agent (WSOS-INT-010, services/session/polkit): the shell draws the administrator prompt and
# asks the person at the desk when they are an administrator. Without the PolkitAgent typelib (a Recommends, and the
# build installs none) the session fell back to lxpolkit's generic window, which offered the first administrator.
gir1.2-polkit-1.0
libpolkit-agent-1-0
# Smart-card sign-in, off until enabled (WSOS-DIR-011)
pcscd
opensc
libpam-pkcs11
# Device sign-in with a FIDO2 security key (pam_u2f, pamu2fcfg; Settings > Users > Security key)
libpam-u2f
pamu2fcfg
# Archives in Files (shell/electron/archives.ts): 7zip for zip and 7z (AES-256); Debian's 7zip has no RAR codec
# (non-free), so RAR is read by libarchive (bsdtar); tar with gzip, xz, bzip2 and zstd; zip/unzip for scripts.
7zip
libarchive-tools
zip
unzip
xz-utils
bzip2
# Terminal (the Start menu's "Terminal" in the design, docs/design/boot-install G02Start; Labwc only recommends foot and
# the build installs no recommends) and notify-send for scripts and admins (the shell is the notification server).
foot
libnotify-bin
# Screenshots, the snipping overlay and clipboard history (shell/electron/capture.ts, clipboard.ts): grim captures
# (wlr-screencopy), wl-clipboard copies and watches the clipboard (wlr-data-control), wtype pastes from Super+V; the
# overlay's selection is drawn by the shell itself (no slurp).
grim
wl-clipboard
wtype
# Web browser and media player (WorkSuite defaults: shell/apps/worksuite-mimeapps.list)
firefox-esr
celluloid
# GTK 4 apps (Celluloid, Files' helpers) draw Adwaita's icons, most of them SVG: the theme and the SVG pixbuf loader.
# Without the loader every SVG icon is GTK's missing-image icon (hook 0150 checks the loader is registered).
adwaita-icon-theme
hicolor-icon-theme
librsvg2-common
gstreamer1.0-plugins-good
gstreamer1.0-libav
# Drivers and firmware, offline (Settings › Drivers). The kernel's in-tree drivers are in linux-image; udev loads them
# by modalias, so supported hardware works in the live session and right after install. These are the firmware files
# those drivers load. Listed one by one instead of --firmware-chroot (which pulled every package with a file under
# /lib/firmware: 1.27 GB, switch ASICs, SmartNICs, TV tuners, telephony cards, Raspberry Pi boot files).
# Firmware the image doesn't carry is found online after the computer connects (package service, driverscan.ts).
# Wi-Fi and Ethernet (every chipset family with firmware in Debian):
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity
firmware-mediatek
firmware-intel-misc
firmware-cavium
firmware-bnx2
firmware-bnx2x
firmware-netxen
firmware-myricom
firmware-qlogic
firmware-zd1211
firmware-carl9170
firmware-ath9k-htc
atmel-firmware
# Intel PRO/Wireless 2100/2200/2915: its licence is accepted in config/preseed/firmware.cfg.chroot.
firmware-ipw2x00
wireless-regdb
bluez-firmware
#if ARCHITECTURES arm64
# Qualcomm SoC laptops and boards (Snapdragon: ath11k/ath12k board files, GPU, DSP, video); 300 MB, so arm64 only.
firmware-qcom-soc
firmware-qcom-media
#endif
# Display: Mesa (OpenGL, Vulkan, VA-API, VDPAU) over the in-tree amdgpu, radeon, i915, xe, nouveau, virtio-gpu and, on
# arm64, panfrost, panthor, msm, v3d. firmware-amd-graphics comes with firmware-linux-nonfree, firmware-misc-nonfree has
# NVIDIA's GSP/nouveau firmware; Intel GuC/HuC/DMC is firmware-intel-graphics. The NVIDIA proprietary driver is an
# optional online driver (DKMS), never in the image.
libgl1-mesa-dri
mesa-va-drivers
mesa-vdpau-drivers
va-driver-all
vdpau-driver-all
# Settings › Graphics (#16): what the GPU decodes in hardware (vainfo) and the Vulkan devices (vulkaninfo).
vainfo
vulkan-tools
firmware-amd-graphics
firmware-intel-graphics
firmware-nvidia-graphics
#if ARCHITECTURES amd64
intel-media-va-driver
#endif
# Audio DSPs on current laptops (Intel SOF, Cirrus amplifiers) and CPU microcode.
firmware-sof-signed
firmware-intel-sound
firmware-cirrus
alsa-topology-conf
#if ARCHITECTURES amd64
intel-microcode
amd64-microcode
#endif
# Online driver search: modalias → package suggestions (isenkram), device names (lspci/lsusb), firmware updates from
# LVFS (fwupd), Secure Boot key enrolment for DKMS drivers (mokutil).
isenkram-cli
pciutils
usbutils
fwupd
mokutil
