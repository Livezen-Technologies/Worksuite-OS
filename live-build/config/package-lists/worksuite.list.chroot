# WorkSuite desktop (pulls labwc, greetd, portals, PipeWire, NetworkManager, ...)
worksuite-desktop
# On-device AI assistant (services/ai): the service and llama.cpp runtime only; models are downloaded later, never in
# the image. Vulkan for GPUs that have it (the build installs no recommends).
worksuite-ai
libvulkan1
mesa-vulkan-drivers
# Locales: locale-gen and /etc/locale.gen. Without it only C.utf8 exists, so LANG=en_US.UTF-8 made foot and Firefox
# warn "locale not supported", and Calamares' localecfg (which runs locale-gen only when /etc/locale.gen exists) could
# not generate the language chosen in the installer. The image's locales: hook 0100-worksuite-defaults.
locales
# Installer (live only; Calamares removes itself from the installed system)
calamares
calamares-settings-worksuite
# Tools Calamares' modules run (only recommended, and the build installs no recommends): unpackfs needs unsquashfs
# and rsync, bootloader needs efibootmgr, and the signed GRUB for Secure Boot behind shim.
squashfs-tools
rsync
efibootmgr
#if ARCHITECTURES amd64
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
grub-efi-arm64-signed
#endif
worksuite-branding
# Hardware / boot
grub-efi
shim-signed
cryptsetup
# File systems the installer creates: FAT32 for the EFI partition (kpmcore runs mkfs.fat)
dosfstools
mtools
cryptsetup-initramfs
# update-initramfs hooks: keyboard map for the passphrase prompt, and the zstd compressor (initramfs-tools default)
console-setup
zstd
tpm2-tools
firmware-linux-free
plymouth
# Crashed apps: core dumps go to the journal, the shell says "X quit unexpectedly" (electron/sessionHost.ts).
systemd-coredump
# Scripts for the installer's language list and the desktop (Sinhala, Tamil, Devanagari, Arabic, ...)
fonts-noto-core
# Emoji in the shell (emoji picker, clipboard history) and apps; without it they were empty boxes.
fonts-noto-color-emoji
# Recovery (§9.2)
dialog
udisks2
# Settings bridge CLIs (shell/electron/system.ts): nmcli, bluetoothctl, wpctl, upower, lpstat, wlr-randr, udisksctl
network-manager
# WireGuard VPN (WSOS-INT-001): NetworkManager's built-in wireguard type (kernel module is in-tree); wg(8) for
# diagnostics; nft for the managed VPN kill switch (services/device-agent/src/vpn.ts)
wireguard-tools
nftables
# OpenVPN profiles imported in Settings › Network › VPN (shell/electron/openvpn.ts)
network-manager-openvpn
bluez
wireplumber
upower
cups-client
wlr-randr
# Touchscreen, pen and touch mode (shell/electron/touch.ts): device listing and tablet-mode switch events,
# auto-rotate (monitor-sensor), and the on-screen keyboard (virtual-keyboard + layer-shell under Labwc)
libinput-tools
iio-sensor-proxy
wvkbd
# WorkSuite greeter (WSOS-AUTH-001; the build installs no recommends)
python3-gi
python3-gi-cairo
gir1.2-gtk-4.0
# worksuite-osk (the WorkSuite on-screen keyboard) is a gtk4-layer-shell surface; without it the shell falls back to wvkbd.
gir1.2-gtk4layershell-1.0
# The library itself: Debian's typelib package does not depend on it, and worksuite-osk preloads it.
libgtk4-layer-shell0
# WorkSuite's own polkit agent (WSOS-INT-010, services/session/polkit): the shell draws the administrator prompt and
# asks the person at the desk when they are an administrator. Without the PolkitAgent typelib (a Recommends, and the
# build installs none) the session fell back to lxpolkit's generic window, which offered the first administrator.
gir1.2-polkit-1.0
libpolkit-agent-1-0
# Smart-card sign-in, off until enabled (WSOS-DIR-011)
pcscd
opensc
libpam-pkcs11
# Device sign-in with a FIDO2 security key (pam_u2f, pamu2fcfg; Settings > Users > Security key)
libpam-u2f
pamu2fcfg
# Archives in Files (shell/electron/archives.ts): 7zip for zip and 7z (AES-256); Debian's 7zip has no RAR codec
# (non-free), so RAR is read by libarchive (bsdtar); tar with gzip, xz, bzip2 and zstd; zip/unzip for scripts.
7zip
libarchive-tools
zip
unzip
xz-utils
bzip2
# Terminal (the Start menu's "Terminal" in the design, docs/design/boot-install G02Start; Labwc only recommends foot and
# the build installs no recommends) and notify-send for scripts and admins (the shell is the notification server).
foot
libnotify-bin
# Screenshots, the snipping overlay and clipboard history (shell/electron/capture.ts, clipboard.ts): grim captures
# (wlr-screencopy), wl-clipboard copies and watches the clipboard (wlr-data-control), wtype pastes from Super+V; the
# overlay's selection is drawn by the shell itself (no slurp).
grim
wl-clipboard
wtype
# Web browser and media player (WorkSuite defaults: shell/apps/worksuite-mimeapps.list)
firefox-esr
celluloid
# GTK 4 apps (Celluloid, Files' helpers) draw Adwaita's icons, most of them SVG: the theme and the SVG pixbuf loader.
# Without the loader every SVG icon is GTK's missing-image icon (hook 0150 checks the loader is registered).
adwaita-icon-theme
hicolor-icon-theme
librsvg2-common
gstreamer1.0-plugins-good
gstreamer1.0-libav
