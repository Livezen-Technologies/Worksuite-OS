#!/bin/sh
# Boot-time package repair (SRS §9.2, WSOS-APT-006). Runs before the greeter (worksuite-boot-repair.service).
# Repairs when dpkg reports an interrupted run, or when /var/lib/worksuite/repair-on-boot exists (set by the
# recovery screens or the package service). Fixed commands only; result in /run/worksuite/boot-repair.
# Exit 0 = nothing to do or repaired; 1 = repair failed (the unit then starts worksuite-recovery.target).
set -u
flag=${WORKSUITE_REPAIR_FLAG:-/var/lib/worksuite/repair-on-boot}
status_dir=${WORKSUITE_RUN_DIR:-/run/worksuite}
mkdir -p "$status_dir"
log() { echo "worksuite-boot-repair: $*"; }

# A package manager that is running is not an interrupted one: during an upgrade (dpkg restarts this unit from a
# postinst) dpkg --audit lists the packages being configured right now. Repairing would fight dpkg for its lock, fail,
# and isolate the recovery screens in the middle of the person's session. Leave it alone.
if pgrep -x 'dpkg|apt-get|apt|aptitude' >/dev/null 2>&1; then
  echo busy > "$status_dir/boot-repair"; log "a package manager is running; nothing to repair"; exit 0
fi
# One failure per boot is enough: worksuite-recovery.target pulls this unit in again, and failing again would isolate
# the target again, in a loop. The recovery screens already show the failure.
if [ "$(cat "$status_dir/boot-repair" 2>/dev/null)" = failed ]; then
  log "repair already failed this boot; recovery screens are open"; exit 0
fi
audit=$(dpkg --audit 2>/dev/null || true)
if [ -z "$audit" ] && [ ! -e "$flag" ]; then
  echo clean > "$status_dir/boot-repair"; exit 0
fi
log "repair needed (${audit:+dpkg interrupted}${audit:+ }$( [ -e "$flag" ] && echo requested))"
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
ok=1
dpkg --configure -a || ok=0
apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -f install || ok=0
[ -z "$(dpkg --audit 2>/dev/null || true)" ] || ok=0
if [ $ok = 1 ]; then
  rm -f "$flag"; echo repaired > "$status_dir/boot-repair"; log "repaired"; exit 0
fi
echo failed > "$status_dir/boot-repair"; log "repair failed; starting recovery"; exit 1
