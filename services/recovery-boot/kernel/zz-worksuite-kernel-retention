#!/bin/sh
# /etc/kernel/postinst.d and postrm.d hook — WSOS-BOOT-003: never let apt autoremove the previous kernel.
# Writes APT::NeverAutoRemove for the newest two installed linux-image packages plus the running one, so a failed
# kernel or graphics update can always boot the one before it (GRUB "previous kernel" entry).
# Test hooks: WORKSUITE_BOOT_DIR, WORKSUITE_APT_CONF, WORKSUITE_RUNNING (default uname -r).
set -e
boot=${WORKSUITE_BOOT_DIR:-/boot}
out=${WORKSUITE_APT_CONF:-/etc/apt/apt.conf.d/01worksuite-kernel-retention}
running=${WORKSUITE_RUNNING:-$(uname -r)}
keep=$( { for k in "$boot"/vmlinuz-*; do [ -f "$k" ] && echo "${k#"$boot"/vmlinuz-}"; done | sort -V | tail -n 2; echo "$running"; } | sort -uV)
tmp="$out.tmp"
{
  echo '// Generated by zz-worksuite-kernel-retention (WSOS-BOOT-003). Do not edit.'
  echo 'APT::NeverAutoRemove {'
  for v in $keep; do
    q=$(printf '%s' "$v" | sed 's/[.+]/\\&/g')
    echo "  \"^linux-image-$q\$\";"
    echo "  \"^linux-modules-$q\$\";"
  done
  echo '};'
} > "$tmp"
mv "$tmp" "$out"
