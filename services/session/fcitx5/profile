# Default fcitx5 input methods for WorkSuite sessions (WSOS-INT-011), installed as /etc/xdg/fcitx5/profile.
# Users change the list in Settings > Devices > Keyboard and input methods (written to ~/.config/fcitx5/profile).
# Sinhala (Wijesekara keyboard, and Singlish phonetic typing) and Tamil come from fcitx5-m17n (m17n-db). Ctrl+Space switches.
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=m17n_si_wijesekera
Layout=

[Groups/0/Items/2]
Name=m17n_si_singlish
Layout=

[Groups/0/Items/3]
Name=m17n_ta_tamil99
Layout=

[GroupOrder]
0=Default
