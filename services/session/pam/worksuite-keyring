Name: WorkSuite: unlock the login keyring with the sign-in password (WSOS-INT-009)
Default: yes
Priority: -1
Auth-Type: Additional
Auth-Final:
	[success=ignore default=2]	pam_succeed_if.so quiet service in greetd:login
	[success=ignore default=1]	pam_exec.so quiet /usr/lib/worksuite/worksuite-signin pam-password-used
	optional	pam_gnome_keyring.so
Session-Type: Additional
Session-Interactive-Only: yes
Session-Final:
	[success=ignore default=1]	pam_succeed_if.so quiet uid >= 1000
	optional	pam_gnome_keyring.so auto_start
