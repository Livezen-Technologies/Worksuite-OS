<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WorkSuite</vendor>
  <vendor_url>https://download.worksuitecloud.com</vendor_url>
  <action id="lk.worksuite.signin.manage">
    <description>Change how you sign in to this computer</description>
    <message>Enter your password to change your PIN or security keys</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- The person proves their own password every time (no _keep): a PIN or key never replaces it here. -->
      <allow_active>auth_self</allow_active>
    </defaults>
    <!-- Settings > Users runs "worksuite-signin pin-set|pin-remove|key-add|key-remove" through pkexec; the account is
         PKEXEC_UID, the PIN is on stdin. -->
    <!-- Checked by lk.worksuite.SignIn1 for each method (services/session/signin/worksuite_signin/bus.py); the helper may still be run through pkexec by an administrator. -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/worksuite/worksuite-signin</annotate>
  </action>
</policyconfig>
