// WorkSuite: the person at the desk manages printers (Settings › Printers, worksuite-printer-admin) without a password
// when they are a printer administrator (lpadmin, as cupsd itself allows) or a system administrator (sudo). Anyone else
// is asked for an administrator's password (lk.worksuite.printers: auth_admin_keep).
polkit.addRule(function (action, subject) {
    if (action.id == "lk.worksuite.printers" && subject.local && subject.active &&
        (subject.isInGroup("lpadmin") || subject.isInGroup("sudo"))) {
        return polkit.Result.YES;
    }
});
