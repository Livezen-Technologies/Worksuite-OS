#!/bin/sh
# WorkSuite session launcher. Installed as /usr/bin/worksuite-session.
#   worksuite-session          run Labwc for the session, clean up when it exits (greetd/wayland-sessions entry)
#   worksuite-session --ready  called from Labwc autostart once Wayland is up: import env, start worksuite-session.target
#   worksuite-session --logout stop session cleanly (also used by the shell's Log out)
set -u

VARS="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP LABWC_PID"

log() { printf '%s\n' "worksuite-session: $*" | systemd-cat -t worksuite-session -p info 2>/dev/null || true; }

ready() {
    # WSOS-SES-001: import display environment into the systemd user manager and D-Bus activation
    # environment BEFORE anything (incl. xdg-desktop-portal) is started.
    export XDG_CURRENT_DESKTOP=WorkSuite:wlroots
    export XDG_SESSION_DESKTOP=WorkSuite
    export XDG_SESSION_TYPE=wayland
    import="WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP"
    [ -n "${DISPLAY:-}" ] && import="$import DISPLAY"   # only when XWayland runs
    [ -n "${LABWC_PID:-}" ] && import="$import LABWC_PID"
    # shellcheck disable=SC2086
    systemctl --user import-environment $import
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $import
    # Portals read XDG_CURRENT_DESKTOP at start; restart any instance started too early.
    systemctl --user try-restart xdg-desktop-portal.service xdg-desktop-portal-wlr.service 2>/dev/null
    systemctl --user --no-block start worksuite-session.target
    log "session target started (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset})"
}

cleanup() {
    # WSOS-SES-003: does not rely on the user manager exiting.
    systemctl --user stop worksuite-sync.service 2>/dev/null          # flushes in-flight batch, closes SQLite
    systemctl --user stop worksuite-credentials.service 2>/dev/null   # drops in-memory access tokens
    dbus-send --session --print-reply --dest=org.freedesktop.secrets /org/freedesktop/secrets \
        org.freedesktop.Secret.Service.Lock array:objpath:/org/freedesktop/secrets/collection/login >/dev/null 2>&1
    systemctl --user stop worksuite-session.target 2>/dev/null
    systemctl --user stop graphical-session.target 2>/dev/null
    # A user manager that outlives the session (another login on a VT, lingering) kept this locked daemon, and the next
    # sign-in's PAM-started daemon could not take over: apps then asked to unlock the login keyring (WSOS-INT-009).
    # Stopping it lets the next sign-in start and unlock a fresh one with the password. Only after the session's apps
    # are gone: a Secret Service call from one of them would start it again, locked (D-Bus activation, --start).
    # Its socket unit stays, so the next sign-in's PAM module starts the daemon through it.
    systemctl --user stop gnome-keyring-daemon.service 2>/dev/null
    # shellcheck disable=SC2086
    systemctl --user unset-environment $VARS
    log "session cleaned up"
}

case "${1:-}" in
    --ready)  ready ;;
    --logout) cleanup; [ -n "${LABWC_PID:-}" ] && kill -TERM "$LABWC_PID" ;;
    "")
        # Nothing the session prints may reach the VT (Xwayland's xkbcomp warnings showed on sign-out and restart):
        # Labwc and everything it starts log to the journal instead.
        if [ -z "${WORKSUITE_SESSION_JOURNAL:-}" ] && command -v systemd-cat >/dev/null 2>&1; then
            WORKSUITE_SESSION_JOURNAL=1 exec systemd-cat -t worksuite-session "$0"
        fi
        # Kiosk mode (device policy, WSOS-AUTH-002): the kiosk account gets the kiosk session, never the full shell.
        kiosk=$(sed -n 's/^KIOSK_USER=//p' "${WORKSUITE_KIOSK_ENV:-/etc/worksuite/kiosk/session.env}" 2>/dev/null | head -n 1)
        if [ -n "$kiosk" ] && [ "$kiosk" = "$(id -un)" ]; then exec "${WORKSUITE_KIOSK_SESSION:-/usr/lib/worksuite/worksuite-kiosk-session}"; fi
        # Clear stale variables from a previous session before starting.
        # shellcheck disable=SC2086
        systemctl --user unset-environment $VARS 2>/dev/null
        export XDG_CURRENT_DESKTOP=WorkSuite:wlroots XDG_SESSION_TYPE=wayland
        . "${WORKSUITE_WLR_ENV:-/usr/lib/worksuite/wlr-env}"
        # Per-user Labwc config dir: the system files, linked, except rc.xml once Settings › Touchscreen & pen has
        # written its own copy (shell/electron/touch.ts adds the touch block to the system rc.xml).
        SYSCONF=${WORKSUITE_LABWC_SYSCONF:-/etc/xdg/worksuite/labwc}
        CONF=${XDG_CONFIG_HOME:-$HOME/.config}/worksuite/labwc
        if mkdir -p "$CONF" 2>/dev/null; then
            for f in "$SYSCONF"/*; do
                [ -e "$f" ] || continue
                n=$(basename "$f")
                [ "$n" = rc.xml ] && [ -f "$CONF/rc.xml" ] && [ ! -L "$CONF/rc.xml" ] && continue
                ln -sfn "$f" "$CONF/$n"
            done
            # A copy written by an older version keeps its old window rules and bindings (the shell was omnipresent,
            # which hid every app): rebuild it from the system file, keeping its desktops, Alt+Tab scope and touch block.
            if [ -f "$CONF/rc.xml" ] && [ ! -L "$CONF/rc.xml" ] && [ -f "$SYSCONF/rc.xml" ]; then
                python3 -Es - "$CONF/rc.xml" "$SYSCONF/rc.xml" "${WORKSUITE_BRIDGE_LIB:-/usr/lib/worksuite/wayland-bridge}" <<'PY' >/dev/null 2>&1 || true
import os, sys
user, system, lib = sys.argv[1:4]
sys.path.insert(0, lib)
from worksuite_bridge.workspace import refresh_rc
old = open(user, encoding="utf-8").read()
new = refresh_rc(old, open(system, encoding="utf-8").read())
if new != old:
    with open(user + ".tmp", "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(user + ".tmp", user)
PY
            fi
        else
            CONF=$SYSCONF
        fi
        # XDG user folders (Documents, Downloads, …) exist from the first sign-in; Files opens on Documents.
        xdg-user-dirs-update >/dev/null 2>&1 || true
        labwc -C "$CONF"
        rc=$?
        cleanup
        # WSOS-SES-006: unexpected compositor exit → greeter shows a notice on next display.
        if [ "$rc" -ne 0 ]; then
            mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/worksuite"
            echo "compositor-exit $rc $(date -u +%FT%TZ)" > "${XDG_STATE_HOME:-$HOME/.local/state}/worksuite/last-session-abnormal"
            # Read (and removed) by the greeter wrapper, /usr/lib/worksuite/worksuite-greeter.
            echo "compositor-exit $rc" > "${WORKSUITE_NOTICE_DIR:-/run/worksuite/session-notice}/uid-$(id -u)" 2>/dev/null || true
        fi
        exit "$rc"
        ;;
    *) echo "usage: worksuite-session [--ready|--logout]" >&2; exit 2 ;;
esac
