#!/bin/sh
# polkit authentication agent for the WorkSuite session (WSOS-INT-010). Installed as
# /usr/lib/worksuite/worksuite-polkit-agent.
# G05: the WorkSuite agent (services/session/polkit) registers with polkitd and the shell draws the prompt: action,
# requesting program, administrator account, tries left and the pam_faillock lockout (WSOS-AUTH-004). PAM checks the
# password. polkit itself is spoken by worksuite-polkit-listener (C). lxpolkit (GTK) or mate-polkit stays as the
# fallback when the listener or python3-gi is missing, or WORKSUITE_POLKIT_LEGACY is set.
set -u
if [ -z "${WORKSUITE_POLKIT_LEGACY:-}" ] && [ -x "${WORKSUITE_POLKIT_LISTENER:=/usr/lib/worksuite/worksuite-polkit-listener}" ] \
    && python3 -c 'from gi.repository import GLib' >/dev/null 2>&1; then
    PYTHONPATH=/usr/lib/worksuite/polkit${PYTHONPATH:+:$PYTHONPATH} exec python3 -m worksuite_polkit_agent
fi
for a in /usr/bin/lxpolkit /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do
    [ -x "$a" ] && exec "$a"
done
echo "worksuite-polkit-agent: no polkit authentication agent installed (lxpolkit or mate-polkit)" >&2
exit 1
