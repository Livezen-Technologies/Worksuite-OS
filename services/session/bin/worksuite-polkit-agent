#!/bin/sh
# polkit authentication agent for the WorkSuite session (WSOS-INT-010). Installed as
# /usr/lib/worksuite/worksuite-polkit-agent. The agent dialog names the action, the requesting program and the
# administrator account; PAM checks the password (and pam_faillock counts failures, WSOS-AUTH-004).
# lxpolkit (GTK) is the qualified agent; mate-polkit is accepted as the alternative dependency.
set -u
for a in /usr/bin/lxpolkit /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do
    [ -x "$a" ] && exec "$a"
done
echo "worksuite-polkit-agent: no polkit authentication agent installed (lxpolkit or mate-polkit)" >&2
exit 1
