#!/bin/sh
# Greeter wrapper run by greetd inside cage (installed as /usr/lib/worksuite/worksuite-greeter).
# WSOS-SES-006: when a WorkSuite session ended because the compositor exited, worksuite-session leaves a notice in
# /run/worksuite/session-notice (tmpfiles: owned by _greetd, mode 1733, so users can drop a file but not read or
# remove anyone else's). The greeter shows one notice, removes them all, then starts gtkgreet.
set -u
DIR=${WORKSUITE_NOTICE_DIR:-/run/worksuite/session-notice}
show=0
for f in "$DIR"/uid-*; do
    [ -f "$f" ] || continue
    show=1
    rm -f "$f"
done
if [ "$show" -eq 1 ]; then
    ${WORKSUITE_ZENITY:-zenity} --warning --title "WorkSuite" --width 420 --ok-label "Continue to sign in" \
        --text "Your last session ended unexpectedly.\n\nOpen applications may have closed, and unsaved work in them may be lost." \
        >/dev/null 2>&1 || true
fi
# WSOS-AUTH-001: the WorkSuite greeter (greetd IPC, PAM conversation, directory domain, password change, codes).
# gtkgreet stays as the fallback when the greeter cannot start (missing GTK 4 bindings).
if [ -z "${WORKSUITE_GREETER_LEGACY:-}" ] && python3 -c 'import gi; gi.require_version("Gtk", "4.0")' >/dev/null 2>&1; then
    PYTHONPATH=/usr/lib/worksuite/greeter${PYTHONPATH:+:$PYTHONPATH} python3 -m worksuite_greeter && exit 0
fi
exec ${WORKSUITE_GTKGREET:-gtkgreet} "$@"
