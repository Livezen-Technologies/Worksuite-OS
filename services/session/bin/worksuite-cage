#!/bin/sh
# cage with WorkSuite's renderer selection (greeter, live installer). Same arguments as cage.
. "${WORKSUITE_WLR_ENV:-/usr/lib/worksuite/wlr-env}"
# The greeter: cage shows black (and a pointer) from the moment it starts until the greeter's first frame, which took
# over a minute on slow machines (E2E under TCG). Before cage takes the screen (the boot splash, or the dark sign-out
# frame, stays up meanwhile) check GTK 4 for the greeter and load its Python modules and libraries once, so its first
# frame comes as soon as possible after cage starts. WORKSUITE_GREETER_CHECKED tells the greeter wrapper not to check
# again inside cage.
case " $* " in
    *" /usr/lib/worksuite/worksuite-greeter "*|*" /usr/lib/worksuite/worksuite-greeter")
        if [ -z "${WORKSUITE_GREETER_LEGACY:-}" ] && PYTHONPATH=/usr/lib/worksuite/greeter${PYTHONPATH:+:$PYTHONPATH} \
            ${WORKSUITE_PYTHON:-python3} -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_foreign("cairo"); import worksuite_greeter.ui' >/dev/null 2>&1; then
            export WORKSUITE_GREETER_CHECKED=1
        fi ;;
    # The live installer the same way: its loading screen (the veil) is up as soon as cage is, and Plymouth's last
    # frame stays on screen meanwhile (greetd: plymouth deactivate; quit --retain-splash once the veil has drawn).
    *" /usr/lib/worksuite/worksuite-installer-start "*|*" /usr/lib/worksuite/worksuite-installer-start")
        if PYTHONPATH=/usr/lib/worksuite/greeter${PYTHONPATH:+:$PYTHONPATH} \
            ${WORKSUITE_PYTHON:-python3} -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_foreign("cairo"); from gi.repository import Gtk; import worksuite_greeter.veil, worksuite_greeter.i18n' >/dev/null 2>&1; then
            export WORKSUITE_INSTALLER_CHECKED=1
        fi ;;
esac
exec ${WORKSUITE_CAGE:-cage} "$@"
