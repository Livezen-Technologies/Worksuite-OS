#!/bin/sh
# Sourced before starting a wlroots compositor (cage, labwc). Virtual and basic display adapters have no working
# GPU acceleration: the GLES renderer then fails and the compositor exits (black screen, greetd restart loop).
# Use the CPU renderer there; keep the GPU on real hardware. An explicit WLR_RENDERER from the environment wins.
if [ -z "${WLR_RENDERER:-}" ]; then
    for card in /sys/class/drm/card[0-9]*; do
        [ -e "$card/device/driver" ] || continue
        case "$(basename "$(readlink -f "$card/device/driver")")" in
            virtio_gpu|virtio-pci|qxl|bochs|bochs-drm|cirrus|cirrus-qemu|vboxvideo|vmwgfx|simpledrm|simple-framebuffer|efifb|hyperv_drm|mgag200|ast)
                export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 ;;
            *) unset WLR_RENDERER; break ;;   # a real GPU (i915, xe, amdgpu, radeon, nouveau, nvidia…)
        esac
    done
fi
