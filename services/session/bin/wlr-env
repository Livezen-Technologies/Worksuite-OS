#!/bin/sh
# Sourced before starting a wlroots compositor (cage, labwc). Picks the renderer (#16, Settings › Graphics):
# - the GPU (GLES/Vulkan through Mesa or the vendor driver) on real hardware;
# - the CPU (pixman) on virtual and basic display adapters, which have no working GPU acceleration: the GLES renderer
#   then fails and the compositor exits (black screen, greetd restart loop);
# - the person's choice in ~/.config/worksuite/graphics.conf (renderer=auto|gpu|software), e.g. the GPU in a virtual
#   machine with 3D acceleration turned on;
# - the CPU after the compositor failed on the GPU (worksuite-session writes renderer-fallback), until Settings ›
#   Graphics tries the GPU again.
# An explicit WLR_RENDERER from the environment wins. WORKSUITE_RENDERER (gpu|software|unknown) and
# WORKSUITE_RENDERER_REASON tell the shell what was chosen: it renders its own windows the same way.
_ws_software() {
    export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
    # GTK 4 (greeter, veils, toasts, keyboard): its GL renderer on llvmpipe made the greeter's first frame slow; the
    # cairo renderer draws these simple surfaces at once.
    [ -n "${GSK_RENDERER:-}" ] || { export GSK_RENDERER=cairo; _ws_gsk=1; }
    export WORKSUITE_RENDERER=software WORKSUITE_RENDERER_REASON="$1"
}
_ws_choice=auto
_ws_conf=${WORKSUITE_GRAPHICS_CONF:-${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/worksuite/graphics.conf}
if [ -r "$_ws_conf" ]; then
    _ws_choice=$(sed -n 's/^[[:space:]]*renderer[[:space:]]*=[[:space:]]*"\{0,1\}\(auto\|gpu\|software\)"\{0,1\}[[:space:]]*$/\1/p' "$_ws_conf" | tail -n 1)
    [ -n "$_ws_choice" ] || _ws_choice=auto
fi
_ws_fallback=${WORKSUITE_RENDERER_FALLBACK:-${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/worksuite/renderer-fallback}
if [ -n "${WLR_RENDERER:-}" ]; then
    if [ "$WLR_RENDERER" = pixman ]; then export WORKSUITE_RENDERER=software; else export WORKSUITE_RENDERER=gpu; fi
    export WORKSUITE_RENDERER_REASON=environment
elif [ "$_ws_choice" = software ]; then
    _ws_software choice
elif [ "$_ws_choice" = gpu ]; then
    export WORKSUITE_RENDERER=gpu WORKSUITE_RENDERER_REASON=choice
elif [ -e "$_ws_fallback" ]; then
    _ws_software fallback
else
    export WORKSUITE_RENDERER=unknown WORKSUITE_RENDERER_REASON=no_display
    for card in "${WORKSUITE_SYSFS:-/sys}"/class/drm/card[0-9]*; do
        [ -e "$card/device/driver" ] || continue
        case "$(basename "$(readlink -f "$card/device/driver")")" in
            virtio_gpu|virtio-pci|qxl|bochs|bochs-drm|cirrus|cirrus-qemu|vboxvideo|vmwgfx|simpledrm|simple-framebuffer|efifb|hyperv_drm|mgag200|ast)
                _ws_software virtual_gpu ;;
            *)  # a real GPU (i915, xe, amdgpu, radeon, nouveau, nvidia…)
                unset WLR_RENDERER WLR_NO_HARDWARE_CURSORS QT_QUICK_BACKEND
                [ -n "${_ws_gsk:-}" ] && unset GSK_RENDERER
                export WORKSUITE_RENDERER=gpu WORKSUITE_RENDERER_REASON=auto
                break ;;
        esac
    done
fi
unset _ws_choice _ws_conf _ws_fallback _ws_gsk
# The system keyboard layout (Settings, the installer: /etc/default/keyboard) for the greeter and the live installer,
# whose compositor would otherwise start with US English. An explicit XKB_DEFAULT_LAYOUT wins.
if [ -z "${XKB_DEFAULT_LAYOUT:-}" ] && [ -r "${WORKSUITE_KEYBOARD_CONF:-/etc/default/keyboard}" ]; then
    XKBLAYOUT=; XKBVARIANT=; XKBOPTIONS=; XKBMODEL=
    . "${WORKSUITE_KEYBOARD_CONF:-/etc/default/keyboard}"
    [ -n "$XKBLAYOUT" ] && export XKB_DEFAULT_LAYOUT="$XKBLAYOUT"
    [ -n "$XKBVARIANT" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
    [ -n "$XKBOPTIONS" ] && export XKB_DEFAULT_OPTIONS="$XKBOPTIONS"
    [ -n "$XKBMODEL" ] && export XKB_DEFAULT_MODEL="$XKBMODEL"
fi
