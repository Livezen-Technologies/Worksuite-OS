GenericName=WorkSuite Settings
Comment=Network, Bluetooth, displays, sound, personalization, accounts, updates, drivers and security
Exec=/usr/lib/worksuite/shell/worksuite-shell --control-center
Icon=worksuite-os
Categories=Settings;System;
Keywords=update;usb;driver;firmware;enroll;organization;taskbar;glass;blur;personalization;security;account;network;wifi;bluetooth;display;sound;power;printer;keyboard;mouse;accessibility;wallpaper;background;
StartupWMClass=worksuite-shell
Actions=Updates;Drivers;Personalization;

