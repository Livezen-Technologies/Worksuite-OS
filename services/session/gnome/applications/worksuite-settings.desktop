[Desktop Entry]
Type=Application
Name=WorkSuite Settings
Name[si]=WorkSuite සැකසීම්
Name[ta]=WorkSuite அமைப்புகள்
Comment=WorkSuite account, updates, drivers, security, taskbar and glass effects (system settings: GNOME Settings)
Exec=/usr/lib/worksuite/shell/worksuite-shell --control-center
Icon=worksuite-os
Categories=Settings;System;
Keywords=update;usb;driver;firmware;enroll;organization;taskbar;glass;blur;personalization;security;account;
StartupWMClass=worksuite-shell
Actions=Updates;Drivers;Personalization;

[Desktop Action Updates]
Name=Updates
Exec=/usr/lib/worksuite/shell/worksuite-shell --control-center Updates

[Desktop Action Drivers]
Name=Drivers
Exec=/usr/lib/worksuite/shell/worksuite-shell --control-center Drivers

[Desktop Action Personalization]
Name=Personalization
Exec=/usr/lib/worksuite/shell/worksuite-shell --control-center Personalization
