# WorkSuite defaults for the taskbar (dash-to-panel), Start menu (ArcMenu) and glass (blur-my-shell), in the
# "worksuite" dconf system database (/etc/dconf/profile/user: user-db:user, then system-db:worksuite).
# Why not a gschema override like the rest: GNOME 48 extensions read their settings through their own
# schemas/gschemas.compiled, which knows nothing of system overrides. On first start dash-to-panel then saw its
# stock defaults and wrote them into the user's settings (taskbar left-aligned, GNOME's Start icon; seen on an
# installed VM). dconf values are seen by every reader, whatever schema file it uses. Not locked: people change
# them in Settings > Personalization. Checked against the real schemas by tests/session/desktop-schema-test.sh.

[org/gnome/shell/extensions/dash-to-panel]
extension-version=9999
panel-position='BOTTOM'
panel-sizes='{"0":48,"1":48,"2":48,"3":48}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"2":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"3":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"centerMonitor"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-element-positions-monitors-sync=true
multi-monitors=true
stockgs-keep-top-panel=false
appicon-margin=4
appicon-padding=6
dot-position='BOTTOM'
dot-style-focused='DASHES'
dot-style-unfocused='DOTS'
focus-highlight=true
focus-highlight-opacity=18
show-window-previews=true
show-favorites=true
group-apps=true
isolate-workspaces=false
intellihide=false
trans-use-custom-bg=true
trans-bg-color='#061029'
trans-use-custom-opacity=true
trans-panel-opacity=0.62
trans-use-dynamic-opacity=false
hot-keys=false
show-showdesktop-hover=false
# Files and Settings as on Ubuntu: GNOME Files (Nautilus) and GNOME Settings; WorkSuite Settings keeps what GNOME
# Settings has no panel for (WorkSuite account, updates, drivers, security, personalization).
# Start menu: WorkSuite button in the taskbar centre, pinned apps, all apps, search (local .desktop files only:
# no file indexer, no web results), user, Settings, Files and the power actions (lock, log out, restart, shut down).

