[Unit]
Description=WorkSuite recovery launcher (minimal app list, Settings, Log out, Report problem)
PartOf=worksuite-session.target
Conflicts=worksuite-shell.service

[Service]
# WSOS-SEC-009: AppArmor (security/apparmor/worksuite-shell, complain mode for now).
AppArmorProfile=-worksuite-shell
Type=simple
ExecStart=/usr/lib/worksuite/shell/worksuite-shell --safe
Restart=on-failure
RestartSec=1s
