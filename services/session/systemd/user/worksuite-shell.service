[Unit]
Description=WorkSuite shell (launcher, dashboard, Settings, App Center)
PartOf=worksuite-session.target
After=worksuite-wayland-bridge.service
# WSOS-SES-005: 3 crashes inside 60 s exhaust the start limit → recovery launcher.
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=worksuite-recovery-launcher.service

[Service]
Type=simple
ExecStart=/usr/lib/worksuite/shell/worksuite-shell
# WSOS-SES-004: restart within 3 s. Apps are not in this cgroup: the shell launches each one into
# its own transient app-worksuite-<id>-<n>.scope under app.slice (shell/electron/session.ts,
# appLaunchCommand), so a crash or restart never kills them (WSOS-REL-004). Log out runs as its
# own transient unit (worksuite-logout.service) for the same reason.
Restart=always
RestartSec=1s
# Electron's main process gets SIGTERM first to close cleanly; anything of the shell's own still
# left (renderer, GPU and utility processes) is then SIGKILLed so a restart never doubles them.
KillMode=mixed
TimeoutStopSec=5s
Slice=session.slice

[Install]
WantedBy=worksuite-session.target
