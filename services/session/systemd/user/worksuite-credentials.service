[Unit]
Description=WorkSuite credentials broker (OneAuth sign-in, keyring-held refresh tokens)
PartOf=worksuite-session.target
Before=worksuite-sync.service

[Service]
Type=simple
# #55: trust the system CA store (private-CA WorkSuite servers), not only the CA list built into Node.
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ExecStart=/usr/bin/worksuite-node --no-warnings /usr/lib/worksuite/credentials/src/main.ts
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=worksuite-session.target
