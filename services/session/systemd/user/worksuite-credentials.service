[Unit]
Description=WorkSuite credentials broker (OneAuth sign-in, keyring-held refresh tokens)
PartOf=worksuite-session.target
Before=worksuite-sync.service

[Service]
Type=simple
ExecStart=/usr/bin/node --no-warnings /usr/lib/worksuite/credentials/src/main.ts
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=worksuite-session.target
