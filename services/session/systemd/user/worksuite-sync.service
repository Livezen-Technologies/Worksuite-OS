[Unit]
Description=WorkSuite sync service (local store, outbox, Drive)
PartOf=worksuite-session.target
Wants=worksuite-credentials.service
After=worksuite-credentials.service

[Service]
Type=simple
# Node >= 22.18 runs the TypeScript sources directly (type stripping); see services/sync/package.json.
ExecStart=/usr/bin/node --no-warnings /usr/lib/worksuite/sync/src/main.ts
Restart=on-failure
RestartSec=5s
# Let an in-flight batch finish and SQLite close cleanly on logout (WSOS-SES-003).
TimeoutStopSec=20s
KillSignal=SIGTERM
Slice=background.slice
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=worksuite-session.target
