[Unit]
Description=WorkSuite graphical session
Documentation=man:systemd.special(7)
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=worksuite-shell.service worksuite-idle.service worksuite-idle-policy.path worksuite-polkit-agent.service worksuite-wayland-bridge.service worksuite-credentials.service worksuite-sync.service worksuite-input-method.service
RefuseManualStart=no
StopWhenUnneeded=no
