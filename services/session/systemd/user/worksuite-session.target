[Unit]
Description=WorkSuite graphical session
Documentation=man:systemd.special(7)
BindsTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=worksuite-shell.service worksuite-panel.service worksuite-wayland-bridge.service worksuite-background.service worksuite-credentials.service worksuite-sync.service
RefuseManualStart=no
StopWhenUnneeded=no
