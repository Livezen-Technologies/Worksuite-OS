<?xml version="1.0" encoding="UTF-8"?>
<!-- WorkSuite defaults for Labwc. Labwc owns windows; panel/launcher/notifications are WorkSuite. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <!-- #16: variable refresh rate (VRR/FreeSync/G-Sync Compatible) for full-screen windows on displays that support
         it; the desktop itself stays at the display's fixed rate (VRR there flickers on some panels). Frames are
         synchronized to the display (no tearing). -->
    <adaptiveSync>fullscreen</adaptiveSync>
    <allowTearing>no</allowTearing>
  </core>
  <!-- One Windows 11-style title bar for every app (issues #15, #33): the WorkSuite theme (services/session/themes,
       WorkSuite-Light when Settings › Appearance is light: shell/electron/windowTheme.ts writes <name> in the user's
       copy), the window icon at the left, the title, then Minimize, Maximize/Restore and Close at the top right;
       8 px rounded corners and a shadow. Labwc's default mouse bindings (no <mouse> section here) give: drag the title bar
       to move, double-click it to maximize or restore, drag an edge or corner to resize, click to focus and raise,
       the taskbar to restore a minimized window. Dialogs and fixed-size windows (minimum = maximum size) keep their
       size: Labwc never resizes them, and their title bars show only the buttons that apply. -->
  <theme>
    <name>WorkSuite</name>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>8</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <font place="ActiveWindow"><name>sans</name><size>9</size></font>
    <font place="InactiveWindow"><name>sans</name><size>9</size></font>
    <font place="OnScreenDisplay"><name>sans</name><size>11</size></font>
  </theme>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <!-- Windows 11 snap: drag a window to the top edge to maximize it, to a side to fill that half. -->
  <snapping>
    <range>10</range>
    <topMaximize>yes</topMaximize>
  </snapping>
  <!-- #53: no edge resistance. Labwc's default (20 px at every screen and window edge) held a dragged window back at
       each edge it met, which made dragging among several windows feel laggy and sticky. -->
  <resistance>
    <screenEdgeStrength>0</screenEdgeStrength>
    <windowEdgeStrength>0</windowEdgeStrength>
  </resistance>
  <!-- Resizing: 8 px corners grab both edges; no size popup. -->
  <resize>
    <popupShow>Never</popupShow>
    <drawContents>yes</drawContents>
    <cornerRange>8</cornerRange>
  </resize>
  <!-- #53: the work area. The taskbar is drawn by the shell's full-screen window (no layer-shell exclusive zone), so the
       52 px at the bottom (shell/src/screens/Desktop.tsx, .ws-taskbar h-[52px]) are kept free here: maximized and
       snapped windows and new windows' placement stop above the taskbar instead of covering it. In touch mode the taskbar
       is 64 px and shell/electron/touch.ts writes 64 in the user's copy (52 again when touch mode ends). -->
  <margin bottom="52"/>
  <!-- One desktop to start with, like Windows 11; Task View adds more (the bridge rewrites this in the user's copy). -->
  <desktops number="1"><popupTime>0</popupTime><names><name>Desktop 1</name></names></desktops>
  <!-- Alt+Tab (#54): Labwc's own switcher (drawn by the compositor: no extra process, no CPU while closed). A list of the
       windows, each with its app icon, its title (two windows of one app differ by title) and its app; the selected one
       is highlighted (theme osd.window-switcher.*), shown live in place of the others (preview) with an outline, and
       activated when Alt is released. Alt+Shift+Tab goes backwards, Esc cancels. The preview is the window itself:
       no screenshot is taken or kept, and nothing is shown that the person's own windows do not. Windows from the desktop in use (Settings ›
       Multitasking can choose all desktops: the bridge and shell/electron/touch.ts change only allWorkspaces). -->
  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="icon" width="6%"/>
      <field content="title" width="70%"/>
      <field content="trimmed_identifier" width="24%"/>
    </fields>
  </windowSwitcher>
  <keyboard>
    <!-- Super opens the WorkSuite launcher via the shell's D-Bus API. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleLauncher"/>
    </keybind>
    <!-- Super+A opens the on-device AI assistant (services/ai). Not Super+Space: fcitx5 switches input-method groups with it. -->
    <keybind key="W-a">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleAssistant"/>
    </keybind>
    <!-- Laptop Fn keys (#62): volume, mute, microphone, screen brightness and media keys, also on the lock screen.
         worksuite-hotkey changes the level (wpctl, brightnessctl / logind, playerctl) and the shell shows it. -->
    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey volume-up"/></keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey volume-down"/></keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey mute"/></keybind>
    <keybind key="XF86AudioMicMute" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey mic-mute"/></keybind>
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey brightness-up"/></keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey brightness-down"/></keybind>
    <keybind key="XF86AudioPlay" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey play-pause"/></keybind>
    <keybind key="XF86AudioPause" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey play-pause"/></keybind>
    <keybind key="XF86AudioNext" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey next"/></keybind>
    <keybind key="XF86AudioPrev" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-hotkey previous"/></keybind>
    <keybind key="XF86Search"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ShowLauncher"/></keybind>
    <keybind key="XF86Explorer"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s files"/></keybind>
    <keybind key="XF86Tools"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s settings"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session"/>
    </keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <!-- Like Windows 11: Super+Up maximizes, Super+Down restores a maximized window and minimizes any other,
         Super+Left/Right snap to that half of the screen. -->
    <keybind key="W-Up"><action name="Maximize"/></keybind>
    <keybind key="W-Down"><action name="If"><query maximized="both"/><then><action name="UnMaximize"/></then><else><action name="Iconify"/></else></action></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <!-- Desktops (WSOS-DSK-003/011), like Windows 11: Super+Tab Task View, Ctrl+Super+D new desktop, Ctrl+Super+F4 close
         it, Ctrl+Super+Left/Right switch (Ctrl+Alt+Left/Right too), Super+1…9 go, Super+Shift+1…9 move the window.
         Each tells the Wayland bridge (worksuite-workspace-event) so the shell follows. Ctrl+Alt+Super+F1…F16 (go),
         Ctrl+Alt+Shift+Super+F1…F16 (move the focused window), Ctrl+Alt+Super+F24 (on all desktops), Ctrl+Alt+Super+F23
         (lift the shell's windows over the apps) Ctrl+Alt+Super+F22 (back below them) and Ctrl+Alt+Super+F21 (raise the lifted shell again) are what the shell sends
         through the bridge. F23/F22 find the shell's windows with ForEach, whatever has the focus, and are idempotent.
         Generated by native/wayland-bridge/worksuite_bridge/workspace.py rc_bindings(), compared in its tests.
         The bridge rewrites <desktops> and <windowSwitcher allWorkspaces> in the user's copy of this file. -->
    <keybind key="W-Tab">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleTaskView"/>
    </keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 4"/></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 5"/></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 6"/></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 7"/></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 8"/></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 9"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 1"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 2"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 3"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 4"/></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 5"/></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 6"/></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 7"/></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 8"/></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 9"/></keybind>
    <keybind key="C-W-Left"><action name="GoToDesktop" to="left" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event left"/></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop" to="right" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event right"/></keybind>
    <keybind key="C-A-Left"><action name="GoToDesktop" to="left" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event left"/></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop" to="right" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event right"/></keybind>
    <keybind key="C-W-d"><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event new"/></keybind>
    <keybind key="C-W-F4"><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event close"/></keybind>
    <keybind key="C-A-W-F1"><action name="GoToDesktop" to="1"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 1"/></keybind>
    <keybind key="C-A-W-F2"><action name="GoToDesktop" to="2"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 2"/></keybind>
    <keybind key="C-A-W-F3"><action name="GoToDesktop" to="3"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 3"/></keybind>
    <keybind key="C-A-W-F4"><action name="GoToDesktop" to="4"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 4"/></keybind>
    <keybind key="C-A-W-F5"><action name="GoToDesktop" to="5"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 5"/></keybind>
    <keybind key="C-A-W-F6"><action name="GoToDesktop" to="6"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 6"/></keybind>
    <keybind key="C-A-W-F7"><action name="GoToDesktop" to="7"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 7"/></keybind>
    <keybind key="C-A-W-F8"><action name="GoToDesktop" to="8"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 8"/></keybind>
    <keybind key="C-A-W-F9"><action name="GoToDesktop" to="9"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 9"/></keybind>
    <keybind key="C-A-W-F10"><action name="GoToDesktop" to="10"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 10"/></keybind>
    <keybind key="C-A-W-F11"><action name="GoToDesktop" to="11"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 11"/></keybind>
    <keybind key="C-A-W-F12"><action name="GoToDesktop" to="12"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 12"/></keybind>
    <keybind key="C-A-W-F13"><action name="GoToDesktop" to="13"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 13"/></keybind>
    <keybind key="C-A-W-F14"><action name="GoToDesktop" to="14"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 14"/></keybind>
    <keybind key="C-A-W-F15"><action name="GoToDesktop" to="15"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 15"/></keybind>
    <keybind key="C-A-W-F16"><action name="GoToDesktop" to="16"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 16"/></keybind>
    <keybind key="C-A-S-W-F1"><action name="SendToDesktop" to="1" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 1"/></keybind>
    <keybind key="C-A-S-W-F2"><action name="SendToDesktop" to="2" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 2"/></keybind>
    <keybind key="C-A-S-W-F3"><action name="SendToDesktop" to="3" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 3"/></keybind>
    <keybind key="C-A-S-W-F4"><action name="SendToDesktop" to="4" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 4"/></keybind>
    <keybind key="C-A-S-W-F5"><action name="SendToDesktop" to="5" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 5"/></keybind>
    <keybind key="C-A-S-W-F6"><action name="SendToDesktop" to="6" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 6"/></keybind>
    <keybind key="C-A-S-W-F7"><action name="SendToDesktop" to="7" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 7"/></keybind>
    <keybind key="C-A-S-W-F8"><action name="SendToDesktop" to="8" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 8"/></keybind>
    <keybind key="C-A-S-W-F9"><action name="SendToDesktop" to="9" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 9"/></keybind>
    <keybind key="C-A-S-W-F10"><action name="SendToDesktop" to="10" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 10"/></keybind>
    <keybind key="C-A-S-W-F11"><action name="SendToDesktop" to="11" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 11"/></keybind>
    <keybind key="C-A-S-W-F12"><action name="SendToDesktop" to="12" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 12"/></keybind>
    <keybind key="C-A-S-W-F13"><action name="SendToDesktop" to="13" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 13"/></keybind>
    <keybind key="C-A-S-W-F14"><action name="SendToDesktop" to="14" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 14"/></keybind>
    <keybind key="C-A-S-W-F15"><action name="SendToDesktop" to="15" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 15"/></keybind>
    <keybind key="C-A-S-W-F16"><action name="SendToDesktop" to="16" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 16"/></keybind>
    <keybind key="C-A-W-F23"><action name="ForEach"><query identifier="worksuite-shell" omnipresent="no"/><then><action name="ToggleAlwaysOnBottom"/><action name="ToggleOmnipresent"/></then></action><action name="ForEach"><query identifier="worksuite-shell"/><then><action name="Raise"/></then></action></keybind>
    <keybind key="C-A-W-F22"><action name="ForEach"><query identifier="worksuite-shell" omnipresent="yes"/><then><action name="ToggleOmnipresent"/><action name="ToggleAlwaysOnBottom"/></then></action></keybind>
    <keybind key="C-A-W-F21"><action name="ForEach"><query identifier="worksuite-shell"/><then><action name="Raise"/></then></action></keybind>
    <keybind key="C-A-W-F24"><action name="ToggleOmnipresent"/></keybind>
    <!-- Screenshots (shell/electron/capture.ts through worksuite-screenshot; xdg-desktop-portal when the shell is not running):
         Print = whole screen, saved to Pictures/Screenshots and copied (or the snipping overlay, Settings › Keyboard),
         Super+Print = the same, Alt+Print = a window to the clipboard, Super+Shift+S and Shift+Print = snipping overlay. -->
    <keybind key="Print"><action name="Execute" command="worksuite-screenshot"/></keybind>
    <keybind key="W-Print"><action name="Execute" command="worksuite-screenshot --save"/></keybind>
    <keybind key="A-Print"><action name="Execute" command="worksuite-screenshot --window"/></keybind>
    <keybind key="W-S-s"><action name="Execute" command="worksuite-screenshot --snip"/></keybind>
    <keybind key="S-Print"><action name="Execute" command="worksuite-screenshot --snip"/></keybind>
    <!-- Like Windows 11 (shell/src/lib/shortcuts.ts lists them all; Settings › Keyboard › Shortcuts changes them in the
         user's copy): Super+E Files, Super+I Settings, Super+N notifications, Super+D show desktop, Super+V clipboard
         history, Super+. emoji, Super+U accessibility, Super+/ this list, Ctrl+Shift+Esc and Ctrl+Alt+Del System monitor,
         Ctrl+Alt+T terminal. -->
    <keybind key="W-e"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s files"/></keybind>
    <keybind key="W-i"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s settings"/></keybind>
    <keybind key="W-n"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleNotifications"/></keybind>
    <keybind key="W-d"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ShowDesktop"/></keybind>
    <keybind key="W-v"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s clipboard"/></keybind>
    <keybind key="W-period"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s emoji"/></keybind>
    <keybind key="W-u"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s a11y"/></keybind>
    <keybind key="W-slash"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s shortcuts"/></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s monitor"/></keybind>
    <keybind key="C-A-Delete"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s monitor"/></keybind>
    <keybind key="C-A-t"><action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 Open s app:foot"/></keybind>
    <!-- Screen-sharing emergency stop (SRS §7.1): ends every ScreenCast session, also while the screen is locked. -->
    <keybind key="W-S-Escape" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-screencast-stop"/></keybind>
  </keyboard>
  <windowRules>
    <!-- The shell's windows (desktop, taskbar, launcher; one per monitor) are full-screen toplevels kept ALWAYS ON BOTTOM.
         Labwc 0.8's always-on-bottom tree sits below every desktop's windows and is shared by all desktops, so:
         * apps always stack above the shell, also after a click on the taskbar (which raises the clicked window);
         * the shell shows on every desktop (2-4 were black with no panel without it);
         * it never counts as the full-screen window on top, which made Labwc hide the top layer (the on-screen keyboard).
         Not ToggleOmnipresent: Labwc re-parents omnipresent windows to the top of the desktop it switches to, which put
         the full-screen shell over every app. While its launcher, notification centre, Files, Task View… are open the shell
         is lifted over the apps with C-A-W-F23 (out of always-on-bottom, omnipresent, raised) and put back with C-A-W-F22.
         Actions in a rule run when the window maps. -->
    <windowRule identifier="worksuite-shell" serverDecoration="yes">
      <action name="ToggleAlwaysOnBottom"/>
    </windowRule>
  </windowRules>
</labwc_config>
