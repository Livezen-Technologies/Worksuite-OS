<?xml version="1.0" encoding="UTF-8"?>
<!-- WorkSuite defaults for Labwc. Labwc owns windows; panel/launcher/notifications are WorkSuite. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <name>WorkSuite</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>sans</name><size>10</size></font>
  </theme>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <!-- One desktop to start with, like Windows 11; Task View adds more (the bridge rewrites this in the user's copy). -->
  <desktops number="1"><popupTime>0</popupTime><names><name>Desktop 1</name></names></desktops>
  <!-- Alt+Tab: windows from the desktop in use (Settings › Multitasking can choose all desktops). -->
  <windowSwitcher allWorkspaces="no"/>
  <keyboard>
    <!-- Super opens the WorkSuite launcher via the shell's D-Bus API. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleLauncher"/>
    </keybind>
    <!-- Super+A opens the on-device AI assistant (services/ai). Not Super+Space: fcitx5 switches input-method groups with it. -->
    <keybind key="W-a">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleAssistant"/>
    </keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="W-l">
      <action name="Execute" command="loginctl lock-session"/>
    </keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <!-- Desktops (WSOS-DSK-003/011), like Windows 11: Super+Tab Task View, Ctrl+Super+D new desktop, Ctrl+Super+F4 close
         it, Ctrl+Super+Left/Right switch (Ctrl+Alt+Left/Right too), Super+1…9 go, Super+Shift+1…9 move the window.
         Each tells the Wayland bridge (worksuite-workspace-event) so the shell follows. Ctrl+Alt+Super+F1…F16 (go),
         Ctrl+Alt+Shift+Super+F1…F16 (move the focused window) and Ctrl+Alt+Super+F24 (on all desktops) are what the shell
         sends through the bridge. Generated by native/wayland-bridge/worksuite_bridge/workspace.py rc_bindings(), compared
         in its tests. The bridge rewrites <desktops> and <windowSwitcher allWorkspaces> in the user's copy of this file. -->
    <keybind key="W-Tab">
      <action name="Execute" command="busctl --user call lk.worksuite.Shell1 /lk/worksuite/Shell1 lk.worksuite.Shell1 ToggleTaskView"/>
    </keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 4"/></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 5"/></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 6"/></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 7"/></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 8"/></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 9"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 1"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 2"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 3"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 4"/></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 5"/></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 6"/></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 7"/></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 8"/></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 9"/></keybind>
    <keybind key="C-W-Left"><action name="GoToDesktop" to="left" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event left"/></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop" to="right" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event right"/></keybind>
    <keybind key="C-A-Left"><action name="GoToDesktop" to="left" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event left"/></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop" to="right" wrap="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event right"/></keybind>
    <keybind key="C-W-d"><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event new"/></keybind>
    <keybind key="C-W-F4"><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event close"/></keybind>
    <keybind key="C-A-W-F1"><action name="GoToDesktop" to="1"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 1"/></keybind>
    <keybind key="C-A-W-F2"><action name="GoToDesktop" to="2"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 2"/></keybind>
    <keybind key="C-A-W-F3"><action name="GoToDesktop" to="3"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 3"/></keybind>
    <keybind key="C-A-W-F4"><action name="GoToDesktop" to="4"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 4"/></keybind>
    <keybind key="C-A-W-F5"><action name="GoToDesktop" to="5"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 5"/></keybind>
    <keybind key="C-A-W-F6"><action name="GoToDesktop" to="6"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 6"/></keybind>
    <keybind key="C-A-W-F7"><action name="GoToDesktop" to="7"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 7"/></keybind>
    <keybind key="C-A-W-F8"><action name="GoToDesktop" to="8"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 8"/></keybind>
    <keybind key="C-A-W-F9"><action name="GoToDesktop" to="9"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 9"/></keybind>
    <keybind key="C-A-W-F10"><action name="GoToDesktop" to="10"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 10"/></keybind>
    <keybind key="C-A-W-F11"><action name="GoToDesktop" to="11"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 11"/></keybind>
    <keybind key="C-A-W-F12"><action name="GoToDesktop" to="12"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 12"/></keybind>
    <keybind key="C-A-W-F13"><action name="GoToDesktop" to="13"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 13"/></keybind>
    <keybind key="C-A-W-F14"><action name="GoToDesktop" to="14"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 14"/></keybind>
    <keybind key="C-A-W-F15"><action name="GoToDesktop" to="15"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 15"/></keybind>
    <keybind key="C-A-W-F16"><action name="GoToDesktop" to="16"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event goto 16"/></keybind>
    <keybind key="C-A-S-W-F1"><action name="SendToDesktop" to="1" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 1"/></keybind>
    <keybind key="C-A-S-W-F2"><action name="SendToDesktop" to="2" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 2"/></keybind>
    <keybind key="C-A-S-W-F3"><action name="SendToDesktop" to="3" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 3"/></keybind>
    <keybind key="C-A-S-W-F4"><action name="SendToDesktop" to="4" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 4"/></keybind>
    <keybind key="C-A-S-W-F5"><action name="SendToDesktop" to="5" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 5"/></keybind>
    <keybind key="C-A-S-W-F6"><action name="SendToDesktop" to="6" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 6"/></keybind>
    <keybind key="C-A-S-W-F7"><action name="SendToDesktop" to="7" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 7"/></keybind>
    <keybind key="C-A-S-W-F8"><action name="SendToDesktop" to="8" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 8"/></keybind>
    <keybind key="C-A-S-W-F9"><action name="SendToDesktop" to="9" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 9"/></keybind>
    <keybind key="C-A-S-W-F10"><action name="SendToDesktop" to="10" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 10"/></keybind>
    <keybind key="C-A-S-W-F11"><action name="SendToDesktop" to="11" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 11"/></keybind>
    <keybind key="C-A-S-W-F12"><action name="SendToDesktop" to="12" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 12"/></keybind>
    <keybind key="C-A-S-W-F13"><action name="SendToDesktop" to="13" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 13"/></keybind>
    <keybind key="C-A-S-W-F14"><action name="SendToDesktop" to="14" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 14"/></keybind>
    <keybind key="C-A-S-W-F15"><action name="SendToDesktop" to="15" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 15"/></keybind>
    <keybind key="C-A-S-W-F16"><action name="SendToDesktop" to="16" follow="no"/><action name="Execute" command="/usr/lib/worksuite/worksuite-workspace-event move 16"/></keybind>
    <keybind key="C-A-W-F24"><action name="ToggleOmnipresent"/></keybind>
    <!-- Screenshot through xdg-desktop-portal (shell/electron/screenshot.ts): Print = whole screen, Shift+Print = choose. -->
    <keybind key="Print"><action name="Execute" command="worksuite-screenshot"/></keybind>
    <keybind key="S-Print"><action name="Execute" command="worksuite-screenshot --interactive"/></keybind>
    <!-- Screen-sharing emergency stop (SRS §7.1): ends every ScreenCast session, also while the screen is locked. -->
    <keybind key="W-S-Escape" allowWhenLocked="yes"><action name="Execute" command="/usr/lib/worksuite/worksuite-screencast-stop"/></keybind>
  </keyboard>
  <windowRules>
    <!-- The shell's own windows are normal toplevels; never fullscreen-as-desktop (§5.1 decision gate). -->
    <!-- The shell (desktop, panel, launcher) is on every workspace: without this, switching to workspace 2-4 showed a black
         screen with no panel (labwc's root menu on click). Actions in a rule run when the window maps. -->
    <windowRule identifier="worksuite-shell" serverDecoration="yes">
      <action name="ToggleOmnipresent"/>
    </windowRule>
  </windowRules>
</labwc_config>
