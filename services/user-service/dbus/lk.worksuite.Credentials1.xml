<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- One token broker for shell, WorkSuite apps and Office (WSOS-IDN-008).
     Refresh token lives only in the Secret Service keyring (WSOS-IDN-002); access tokens only in memory (WSOS-IDN-003).
     Transport: worksuite-credentials (services/credentials/src/main.ts) serves these methods on the 0600 Unix socket
     $XDG_RUNTIME_DIR/worksuite/credentials.sock as line-delimited JSON {id, method, params} → {id, result} or
     {id, error}; only the session user can connect (SRS §10.3). No D-Bus service implements this interface; this file
     records the method contract, kept the same as dispatch() in main.ts. -->
<node name="/lk/worksuite/Credentials1">
  <interface name="lk.worksuite.Credentials1">
    <!-- OIDC auth code + PKCE in the system browser (WSOS-IDN-001). mode: "personal" | "enterprise".
         Returns the account {id, name, server_url}. -->
    <method name="SignIn">
      <arg name="server_url" type="s" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg name="account" type="a{sv}" direction="out"/>
    </method>
    <!-- Signs one account out (keyring entry and in-memory token removed). Unsent changes (WSOS-SYN-008: wait, export
         or discard) are settled by the shell before it calls SignOut (shell/electron/main.ts); the broker has no
         unsent-changes argument. -->
    <method name="SignOut">
      <arg name="account_id" type="s" direction="in"/>
    </method>
    <!-- force_refresh: true after the API answered 401. -->
    <method name="GetAccessToken">
      <arg name="account_id" type="s" direction="in"/>
      <arg name="force_refresh" type="b" direction="in"/>
      <arg name="token" type="s" direction="out"/>
      <arg name="expires_at" type="t" direction="out"/>
    </method>
    <!-- Every account with its state (signed_out | signed_in | refresh_failed | locked). -->
    <method name="Status">
      <arg name="accounts" type="aa{sv}" direction="out"/>
    </method>
    <!-- Session lock and unlock: tokens are not handed out while locked. -->
    <method name="Lock"/>
    <method name="Unlock"/>
  </interface>
  <interface name="lk.worksuite.Sync1">
    <method name="Status"><arg name="status" type="a{sv}" direction="out"/></method>  <!-- pending, failed, conflicts, last_sync -->
    <method name="ListFailed"><arg name="records_json" type="s" direction="out"/></method>
    <method name="RetryFailed"><arg name="mutation_id" type="s" direction="in"/></method>
    <method name="SyncNow"/>
    <signal name="RecordStateChanged">
      <arg name="module" type="s"/><arg name="object_id" type="s"/><arg name="state" type="s"/>
    </signal>
  </interface>
</node>
