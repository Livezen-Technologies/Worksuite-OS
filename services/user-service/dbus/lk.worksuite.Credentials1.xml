<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Session bus. One token broker for shell, WorkSuite apps and Office (WSOS-IDN-008).
     Refresh token lives only in the Secret Service keyring (WSOS-IDN-002); access tokens only in memory (WSOS-IDN-003).
     Callers are checked by UID and executable path (shell, Office); others get AccessDenied. -->
<node name="/lk/worksuite/Credentials1">
  <interface name="lk.worksuite.Credentials1">
    <!-- Starts OIDC auth code + PKCE in the system browser / sign-in window (WSOS-IDN-001). -->
    <method name="SignIn">
      <arg name="server_url" type="s" direction="in"/>
    </method>
    <!-- unsent_choice: "wait" | "export" | "discard" (WSOS-SYN-008; discard needs prior confirmation in UI). -->
    <method name="SignOut">
      <arg name="unsent_choice" type="s" direction="in"/>
    </method>
    <method name="GetAccessToken">
      <arg name="audience" type="s" direction="in"/>
      <arg name="token" type="s" direction="out"/>
      <arg name="expires_at" type="t" direction="out"/>
    </method>
    <property name="State" type="s" access="read"/>   <!-- signed_out | signed_in | refresh_failed | device_revoked -->
    <signal name="StateChanged"><arg name="state" type="s"/></signal>
  </interface>
  <interface name="lk.worksuite.Sync1">
    <method name="Status"><arg name="status" type="a{sv}" direction="out"/></method>  <!-- pending, failed, conflicts, last_sync -->
    <method name="ListFailed"><arg name="records_json" type="s" direction="out"/></method>
    <method name="RetryFailed"><arg name="mutation_id" type="s" direction="in"/></method>
    <method name="SyncNow"/>
    <signal name="RecordStateChanged">
      <arg name="module" type="s"/><arg name="object_id" type="s"/><arg name="state" type="s"/>
    </signal>
  </interface>
</node>
