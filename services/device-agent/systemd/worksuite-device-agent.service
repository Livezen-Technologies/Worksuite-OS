[Unit]
Description=WorkSuite device agent (enrollment, policy, heartbeat, signed remote commands)
Documentation=file:///usr/share/doc/worksuite-device-agent/README.md
Wants=network-online.target
After=network-online.target

[Service]
# WSOS-SEC-009: AppArmor (security/apparmor/); "-" keeps the unit working on kernels without AppArmor.
AppArmorProfile=-worksuite-device-agent
Type=simple
ExecStart=/usr/bin/worksuite-node --no-warnings /usr/lib/worksuite/device-agent/src/main.ts
Restart=on-failure
RestartSec=5s
StateDirectory=worksuite-device-agent
StateDirectoryMode=0700
# device-token, policy.json, status.json for user services and Settings (0644); control.sock is root-only.
RuntimeDirectory=worksuite-device-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
LogsDirectory=worksuite
# Hardening (WSOS-SEC-007). Root is needed for inventory, LUKS key-slot wipe and per-user data wipe;
# package changes go through lk.worksuite.PackageService1, not here.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/worksuite-device-agent /run/worksuite-device-agent /var/log/worksuite /home
# Managed WireGuard VPN keyfile (WSOS-INT-001); "-" = fine if NetworkManager isn't installed.
ReadWritePaths=-/etc/NetworkManager/system-connections
# WorkSuite Security DNS blocklist (#38, src/protection.ts): NetworkManager's dnsmasq drop-in and dns=dnsmasq.
ReadWritePaths=-/etc/NetworkManager/dnsmasq.d -/etc/NetworkManager/conf.d
# Policy enforcement (src/enforce.ts ENFORCED_PATHS): lock/faillock/offline files (and signin-policy.conf), USB storage modprobe and udev rules.
# test/unit.test.ts checks every path the agent writes is covered here and in the AppArmor profile.
ConfigurationDirectory=worksuite
ConfigurationDirectoryMode=0755
ReadWritePaths=/etc/worksuite -/etc/modprobe.d -/etc/udev/rules.d
ProtectHome=no
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# CAP_KILL: resume or end a process WorkSuite Security suspended (#38), at the user's or administrator's request.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_SYS_ADMIN CAP_SYS_BOOT CAP_NET_ADMIN CAP_KILL
DeviceAllow=block-* rw
DevicePolicy=closed
UMask=0077

[Install]
WantedBy=multi-user.target
