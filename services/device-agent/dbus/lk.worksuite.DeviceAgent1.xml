<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Served by worksuite-device-agent (src/dbus.ts; ACTIONS maps each method to its polkit action). System bus: lk.worksuite.DeviceAgent1 at /lk/worksuite/DeviceAgent1.
     Remote commands arrive from the server only; this bus API is for local UI (Settings > About this device). -->
<node name="/lk/worksuite/DeviceAgent1">
  <interface name="lk.worksuite.DeviceAgent1">
    <!-- Read-only status for WSOS-MDM-007 / WSOS-WIPE-007. -->
    <method name="GetManagementInfo">
      <arg name="info" type="a{sv}" direction="out"/>   <!-- managed, org_name, policies, can_wipe_data, can_wipe_device -->
    </method>
    <method name="GetEffectivePolicy">
      <arg name="policy_json" type="s" direction="out"/>
    </method>
    <!-- polkit: lk.worksuite.device.enroll. token is the short-lived admin-issued enrollment token. -->
    <method name="Enroll">
      <arg name="server_url" type="s" direction="in"/>
      <arg name="enrollment_token" type="s" direction="in"/>
      <arg name="device_id" type="s" direction="out"/>
    </method>
    <!-- No authorization required: triggers a policy fetch + heartbeat. -->
    <method name="RefreshNow"/>
    <!-- polkit: lk.worksuite.security.scan. kind: quick (Downloads, Desktop, Documents, autostart, temporary folders) |
         full (local file systems). Returns once started, or fails with NO_SIGNATURES / ANTIVIRUS_MISSING /
         ANTIVIRUS_DISABLED; progress and results are in /run/worksuite-device-agent/security.json. -->
    <method name="StartSecurityScan">
      <arg name="kind" type="s" direction="in"/>
    </method>
    <!-- polkit: lk.worksuite.security.scan. Stops the running scan (NOT_SCANNING when none runs). -->
    <method name="CancelSecurityScan"/>
    <!-- polkit: lk.worksuite.security.scan. freshclam checks for new virus definitions now. -->
    <method name="UpdateSecurityDefinitions"/>
    <!-- polkit: lk.worksuite.security.quarantine (#38). id: a quarantine id from security.json "quarantine". The
         file is re-scanned and put back at its original path; still detected → error STILL_DETECTED. -->
    <method name="RestoreQuarantined">
      <arg name="quarantine_id" type="s" direction="in"/>
    </method>
    <method name="DeleteQuarantined">
      <arg name="quarantine_id" type="s" direction="in"/>
    </method>
    <!-- A process suspended for a burst of renames/deletions in protected folders: action resume | terminate. -->
    <method name="ResolveSuspendedProcess">
      <arg name="event_id" type="s" direction="in"/>
      <arg name="action" type="s" direction="in"/>
    </method>
    <property name="Enrolled" type="b" access="read"/>
    <property name="DeviceId" type="s" access="read"/>
    <property name="LastCheckIn" type="t" access="read"/>
    <signal name="PolicyChanged">
      <arg name="version" type="s"/>
    </signal>
    <signal name="CommandReceived">
      <arg name="command_id" type="s"/>
      <arg name="command" type="s"/>
    </signal>
  </interface>
</node>
