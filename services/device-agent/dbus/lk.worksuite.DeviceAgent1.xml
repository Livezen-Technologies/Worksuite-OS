<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- System bus: lk.worksuite.DeviceAgent1 at /lk/worksuite/DeviceAgent1.
     Remote commands arrive from the server only; this bus API is for local UI (Settings > About this device). -->
<node name="/lk/worksuite/DeviceAgent1">
  <interface name="lk.worksuite.DeviceAgent1">
    <!-- Read-only status for WSOS-MDM-007 / WSOS-WIPE-007. -->
    <method name="GetManagementInfo">
      <arg name="info" type="a{sv}" direction="out"/>   <!-- managed, org_name, policies, can_wipe_data, can_wipe_device -->
    </method>
    <method name="GetEffectivePolicy">
      <arg name="policy_json" type="s" direction="out"/>
    </method>
    <!-- polkit: lk.worksuite.device.enroll. token is the short-lived admin-issued enrollment token. -->
    <method name="Enroll">
      <arg name="server_url" type="s" direction="in"/>
      <arg name="enrollment_token" type="s" direction="in"/>
      <arg name="device_id" type="s" direction="out"/>
    </method>
    <!-- No authorization required: triggers a policy fetch + heartbeat. -->
    <method name="RefreshNow"/>
    <property name="Enrolled" type="b" access="read"/>
    <property name="DeviceId" type="s" access="read"/>
    <property name="LastCheckIn" type="t" access="read"/>
    <signal name="PolicyChanged">
      <arg name="version" type="s"/>
    </signal>
    <signal name="CommandReceived">
      <arg name="command_id" type="s"/>
      <arg name="command" type="s"/>
    </signal>
  </interface>
</node>
