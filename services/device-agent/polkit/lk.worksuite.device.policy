<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WorkSuite</vendor>
  <vendor_url>https://download.worksuitecloud.com</vendor_url>
  <action id="lk.worksuite.device.enroll">
    <description>Enroll this device in an organization</description>
    <message>Authentication is required to enroll this device</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <!-- Checked by lk.worksuite.DeviceAgent1.Enroll (first-run, Settings). The admin CLI may still run
         "worksuite-device-agent enroll" through pkexec: server URL as an option, token on stdin. -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/worksuite-device-agent</annotate>
  </action>
</policyconfig>
