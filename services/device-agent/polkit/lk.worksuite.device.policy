<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WorkSuite</vendor>
  <vendor_url>https://download.worksuitecloud.com</vendor_url>
  <action id="lk.worksuite.device.enroll">
    <description>Enroll this device in an organization</description>
    <message>Authentication is required to enroll this device</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <!-- Checked by lk.worksuite.DeviceAgent1.Enroll (first-run, Settings). The admin CLI may still run
         "worksuite-device-agent enroll" through pkexec: server URL as an option, token on stdin. -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/worksuite-device-agent</annotate>
  </action>
  <action id="lk.worksuite.security.scan">
    <description>Scan this device for malware</description>
    <message>Authentication is required to scan this device for malware</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <!-- lk.worksuite.DeviceAgent1.StartSecurityScan (Settings › Privacy & security › WorkSuite Security). A scan
         only reads files and quarantines detections under the organization's policy; it changes no setting. -->
  </action>
  <action id="lk.worksuite.security.quarantine">
    <description>Restore or delete quarantined files, and resume or end suspended programs</description>
    <message>Authentication is required to change what WorkSuite Security has quarantined or suspended</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- lk.worksuite.DeviceAgent1.RestoreQuarantined / DeleteQuarantined / ResolveSuspendedProcess (#38). Restoring
         re-scans the file first and refuses one that is still detected. -->
  </action>
</policyconfig>
