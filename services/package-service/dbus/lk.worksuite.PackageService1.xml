<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- System bus: lk.worksuite.PackageService1 at /lk/worksuite/PackageService1 -->
<node name="/lk/worksuite/PackageService1">
  <interface name="lk.worksuite.PackageService1">
    <!-- polkit: lk.worksuite.package.install (root callers such as the device agent skip the prompt).
         source: "apt" | "flatpak"; catalog_id "<source>:<name>" or a bare name. On managed devices it must be in the
         signed policy app_allowlist. No URLs, paths or options. "appimage" is refused InvalidArgs: catalog AppImages
         are imported from a file by the user (worksuite-appimage), checked against the catalog SHA-256. -->
    <method name="Install">
      <arg name="source" type="s" direction="in"/>
      <arg name="catalog_id" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <method name="Remove">
      <arg name="source" type="s" direction="in"/>
      <arg name="catalog_id" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- No authorization required: read-only. WSOS-APP-002 preview before confirmation: operation is "install" or
         "remove"; returns JSON {plan:{install,upgrade,remove}, disk_bytes, permissions, broad} with the same checks
         (policy, critical set, sources) as the real call. -->
    <method name="Preview">
      <arg name="source" type="s" direction="in"/>
      <arg name="catalog_id" type="s" direction="in"/>
      <arg name="operation" type="s" direction="in"/>
      <arg name="preview_json" type="s" direction="out"/>
    </method>
    <!-- No authorization required: read-only. Keys: apt (u), flatpak (u), packages (as, APT names),
         flatpaks (as, app ids), reboot_required (b), state (s). Uses the last refreshed package lists. -->
    <method name="CheckUpdates">
      <arg name="summary" type="a{sv}" direction="out"/>
    </method>
    <!-- polkit: lk.worksuite.update.apply. release_id from the signed manifest. -->
    <method name="ApplyUpdate">
      <arg name="release_id" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- polkit: lk.worksuite.repair. Runs fixed commands: dpkg configure-all, then apt-get fix-broken. -->
    <method name="Repair">
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- Only the job's caller (or root), and only while the job is still queued; otherwise Busy. -->
    <method name="CancelJob">
      <arg name="job" type="o" direction="in"/>
    </method>
    <!-- Update coordinator (SRS §14.1, WSOS-AUP-011). Status JSON: state (up_to_date | checking | available | waiting |
         installing | ready_to_restart | restart_pending | failed), version, installed, release_id, mandatory,
         deadline, deferrals_left, reason, restart_at, last_check. -->
    <method name="GetUpdateStatus"><arg name="status_json" type="s" direction="out"/></method>
    <method name="CheckForUpdates"><arg name="status_json" type="s" direction="out"/></method>
    <!-- polkit: lk.worksuite.update.apply. false when no more deferrals are allowed (WSOS-AUP-007). -->
    <method name="DeferUpdate"><arg name="deferred" type="b" direction="out"/></method>
    <!-- polkit: lk.worksuite.update.apply. -->
    <method name="InstallUpdateNow"/>
    <!-- No authorization: read-only. App Center catalog (WSOS-APP-001/003, WSOS-ARM-005) from the enrolled server's
         desktop/v1/os/catalog with the device credential. JSON {state: ok | not_enrolled | unreachable | error, arch,
         items: [{id, source, name, arches, installed, available, blocked_reason, ...}], error?}. Never sample data. -->
    <method name="GetCatalog"><arg name="catalog_json" type="s" direction="out"/></method>
    <!-- WSOS-APT-005 local .deb. Preview (no authorization): the file must be a regular file owned by the caller; it is
         copied into a root-owned spool and checked (control fields, arch, policy allowlist/allow_local_debs, apt
         dependency simulation, critical set). Returns JSON {package, version, architecture, publisher,
         publisher_verified:false, description, plan, disk_bytes, token}. Install takes the token (SHA-256 of the
         staged copy) and needs polkit lk.worksuite.package.install-local (administrator password every time). -->
    <method name="PreviewLocalDeb">
      <arg name="path" type="s" direction="in"/>
      <arg name="preview_json" type="s" direction="out"/>
    </method>
    <method name="InstallLocalDeb">
      <arg name="token" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- WSOS-FLP-003: declared permissions and system overrides (read-only); reset drops system overrides
         (polkit lk.worksuite.package.install). Per-user overrides and app data are reset by the shell as the user. -->
    <method name="GetAppPermissions">
      <arg name="catalog_id" type="s" direction="in"/>
      <arg name="permissions_json" type="s" direction="out"/>
    </method>
    <method name="ResetAppPermissions">
      <arg name="catalog_id" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- WSOS-FLP-004: flatpak uninstall unused (only runtimes no installed app needs). polkit lk.worksuite.package.install. -->
    <method name="PruneRuntimes"><arg name="job" type="o" direction="out"/></method>
    <!-- WSOS-FLP-001. polkit: lk.worksuite.package.add-remote (auth_admin). NotAuthorized unless device policy lists the
         name in approved_remotes and the same https .flatpakrepo URL in flatpak_remotes. -->
    <method name="AddRemote">
      <arg name="name" type="s" direction="in"/>
      <arg name="flatpakrepo_url" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <!-- WSOS-AUP-010 offline .wsupdate bundle from removable media or the caller's home. Inspect (read-only) verifies the
         release-key signature and every package's SHA-256; Install (polkit lk.worksuite.update.apply) re-verifies
         after copying to a root-owned directory and installs with apt (no downloads). -->
    <method name="InspectBundle">
      <arg name="path" type="s" direction="in"/>
      <arg name="bundle_json" type="s" direction="out"/>
    </method>
    <method name="InstallBundle">
      <arg name="path" type="s" direction="in"/>
      <arg name="job" type="o" direction="out"/>
    </method>
    <signal name="UpdateStatusChanged"><arg name="status_json" type="s"/></signal>
    <property name="State" type="s" access="read"/>           <!-- idle | busy | interrupted -->
    <property name="RebootRequired" type="b" access="read"/>
    <signal name="JobProgress">
      <arg name="job" type="o"/>
      <arg name="percent" type="u"/>
      <arg name="phase" type="s"/>
    </signal>
    <signal name="JobFinished">
      <arg name="job" type="o"/>
      <arg name="result" type="s"/>       <!-- success | failed | cancelled -->
      <arg name="details" type="a{sv}"/>
    </signal>
  </interface>
</node>
