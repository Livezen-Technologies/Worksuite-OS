[Unit]
Description=WorkSuite package service (APT/Flatpak via D-Bus + polkit)
Documentation=file:///usr/share/doc/worksuite-package-service/README.md
After=dbus.service

[Service]
# WSOS-SEC-009: AppArmor (security/apparmor/); "-" keeps the unit working on kernels without AppArmor.
AppArmorProfile=-worksuite-package-service
Type=dbus
BusName=lk.worksuite.PackageService1
ExecStart=/usr/bin/worksuite-node --no-warnings /usr/lib/worksuite/package-service/src/main.ts
# Bus-activated. Must not be killed mid-dpkg.
KillMode=mixed
TimeoutStopSec=30min
# Hardening (WSOS-SEC-007). dpkg needs to write / so ProtectSystem=strict is not possible;
# writes are confined to package-manager paths via ReadWritePaths with ProtectSystem=full.
NoNewPrivileges=no
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=no
ProtectControlGroups=yes
# Not ProtectClock= (#59): it implies DeviceAllow=char-rtc, which turns on the device allow-list and leaves only
# /dev/null, zero, random, tty and ptmx. Driver installs run update-initramfs (firmware, DKMS and GPU packages trigger
# it); its cryptsetup and LVM hooks need /dev/mapper/control and the block devices, or an encrypted disk's initramfs
# cannot unlock it. Setting the clock stays blocked by dropping the capabilities instead.
CapabilityBoundingSet=~CAP_SYS_TIME CAP_WAKE_ALARM
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
LockPersonality=yes
# AF_NETLINK: glibc's getaddrinfo (apt's download methods, fwupd's client) asks the kernel for the addresses in use (#45).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=no
SystemCallArchitectures=native
UMask=0022
ReadWritePaths=/var/lib/worksuite-package-service /var/lib/dpkg /var/lib/apt /var/cache/apt /var/lib/flatpak /var/log/worksuite /boot /usr /etc /opt
# Drivers (#45): mokutil queues the Secure Boot key in an EFI variable (ProtectKernelTunables
# makes /sys read-only otherwise), and the ESP may be its own mount below /boot.
ReadWritePaths=-/sys/firmware/efi/efivars -/boot/efi
LogsDirectory=worksuite
StateDirectory=worksuite-package-service
# update-status.json for the device agent (WSOS-MDM-001)
RuntimeDirectory=worksuite-package-service
RuntimeDirectoryMode=0755
StateDirectoryMode=0700

# Not started in the boot rush (it is a Node process; at boot it competed with the greeter for CPU): bus activation
# starts it on demand, and worksuite-package-service.timer starts it 2 min after boot so the update coordinator
# still checks soon after boot and every 6 h (WSOS-AUP-001).
