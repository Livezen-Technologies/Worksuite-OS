# WorkSuite OS boot splash: centred logo on #0b1120, a progress bar, and the disk-unlock prompt.
Window.SetBackgroundTopColor(0.043, 0.067, 0.125);
Window.SetBackgroundBottomColor(0.043, 0.067, 0.125);
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 40, 1);

track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.x = cx - track.image.GetWidth() / 2;
track.y = cy + logo.image.GetHeight() / 2 + 20;
track.sprite.SetPosition(track.x, track.y, 1);
bar.original = Image("progress-bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 2);

fun progress_callback(duration, progress) {
  w = Math.Int(bar.original.GetWidth() * progress);
  if (w < 1) w = 1;
  bar.sprite.SetImage(bar.original.Scale(w, bar.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Disk unlock (LUKS, SRS full-disk encryption).
prompt.sprite = Sprite();
entry.sprite = Sprite();
fun display_password_callback(text, bullets) {
  prompt.sprite.SetImage(Image.Text(text, 0.89, 0.91, 0.94));
  prompt.sprite.SetPosition(cx - prompt.sprite.GetImage().GetWidth() / 2, track.y + 40, 3);
  dots = "";
  for (i = 0; i < bullets; i++) dots += "●";
  entry.sprite.SetImage(Image.Text(dots + " ", 0.0, 0.85, 0.95));
  entry.sprite.SetPosition(cx - entry.sprite.GetImage().GetWidth() / 2, track.y + 70, 3);
  prompt.sprite.SetOpacity(1); entry.sprite.SetOpacity(1);
}
fun display_normal_callback() {
  prompt.sprite.SetOpacity(0); entry.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message.sprite = Sprite();
fun message_callback(text) {
  message.sprite.SetImage(Image.Text(text, 0.6, 0.65, 0.72));
  message.sprite.SetPosition(cx - message.sprite.GetImage().GetWidth() / 2, Window.GetHeight() - 60, 3);
}
Plymouth.SetMessageFunction(message_callback);
